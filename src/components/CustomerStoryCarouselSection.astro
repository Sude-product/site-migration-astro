---
// Ana sayfanın hero'sundaki dashboard widget'ının HEMEN ALTINDAKİ "Müşteri
// Hikayeleri" carousel'i (2026-08-20) — bkz. `customerStoryCarousel.ts`'in
// başındaki kapsam notu. Bu dosya yalnızca SARMALAYICI: locale-bağımsız kart
// tanımlarını (`CUSTOMER_CAROUSEL_CARDS`) i18n metniyle birleştirip
// `CustomerStoryCarousel.tsx`'e (React, `client:visible`) geçiriyor.
import CustomerStoryCarousel from './CustomerStoryCarousel.tsx';
import type { CustomerCarouselCardData, VideoCardData, QuoteCardData, StatCardData } from './CustomerStoryCarousel.tsx';
import { CUSTOMER_CAROUSEL_CARDS } from '../data/customerStoryCarousel';
import { TESTIMONIAL_PEOPLE } from '../data/homeContent';
import { getTranslations } from '../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../data/nav';

const locale = (Astro.currentLocale ?? 'tr') as Locale;
const t = getTranslations(locale);
const cc = t.home.customerCarousel;
const cs = t.customerStories;
const musterilerHref = getRelativeLocaleUrl(locale, 'musteriler');

// Her video kartının kendi nötr başlığı var (`storyKey`'e göre) — birden
// fazla video kartı olabildiği için (Civil + Beyaz Fırın, 2026-08-20)
// `cc.civilVideo.headline`'ı SABİT kullanmak artık YANLIŞ olurdu.
const VIDEO_HEADLINES: Partial<Record<string, string>> = {
  civil: cc.civilVideo.headline,
  femas: cc.femasVideo.headline,
  beyazFirin: cc.beyazFirinVideo.headline,
  ibisStyles: cc.ibisStylesVideo.headline,
};

// 2026-08-24 — eski (ayrı) `TestimonialSection` widget'ından taşınan 2
// tanık (İsmail Ünal/Emre Özcan) `customerStories` şemasında DEĞİL,
// `home.testimonials`'da yaşıyor (`TESTIMONIAL_PEOPLE`'daki isim/fotoyla
// birlikte) — bu tip guard, hangi kaynaktan okunacağını ayırt eder.
type HomeTestimonialKey = 'emreOzcan' | 'ismailUnal';
function isHomeTestimonialKey(key: string): key is HomeTestimonialKey {
  return key === 'emreOzcan' || key === 'ismailUnal';
}

const cards: CustomerCarouselCardData[] = CUSTOMER_CAROUSEL_CARDS.map((card): CustomerCarouselCardData => {
  const base = {
    // Aynı firmanın (Beyaz Fırın) hem video hem alıntı kartı olabildiği
    // için (2026-08-20) `storyKey` tek başına artık BENZERSİZ değil —
    // React `key` çakışmasını önlemek için `type` de eklendi.
    key: `${card.storyKey}-${card.type}`,
    companyName: card.companyName,
    logoUrl: card.logo.url,
    logoWidth: card.logo.width,
    logoHeight: card.logo.height,
    // "Devamını Oku" ARTIK HER kartta var (2026-08-25, kullanıcı isteği) —
    // `anchorId` varsa `/musteriler/`'deki ilgili bloğa (`#anchorId`) gider,
    // yoksa (emreOzcan/ismailUnal — o sayfada kendilerine ait bir blok yok)
    // düz `/musteriler/`'e gider. Önceki turda anchorId yoksa link HİÇ
    // render edilmiyordu — kullanıcı artık tutarlılık için tümünde
    // istiyor, uydurma bir ANCHOR eklenmedi, yalnızca sayfanın kendisine
    // yönlendiriliyor.
    readMoreLabel: cc.readMoreLabel,
    readMoreHref: card.anchorId ? `${musterilerHref}#${card.anchorId}` : musterilerHref,
  };

  if (card.type === 'video') {
    const videoCard: VideoCardData = {
      ...base,
      type: 'video',
      videoUrl: card.videoUrl,
      headline: VIDEO_HEADLINES[card.storyKey] ?? '',
      playLabel: cs.videoPlayLabel,
      loopStart: card.loopStart,
      loopEnd: card.loopEnd,
      loopVideoUrl: card.loopVideoUrl,
    };
    return videoCard;
  }

  if (card.type === 'quote') {
    if (isHomeTestimonialKey(card.storyKey)) {
      const testimonial = t.home.testimonials[card.storyKey];
      const person = TESTIMONIAL_PEOPLE[card.storyKey];
      const quoteCard: QuoteCardData = {
        ...base,
        type: 'quote',
        quoteText: testimonial.quote,
        personName: person.name,
        personRole: testimonial.jobTitle,
        photoUrl: person.photoUrl,
      };
      return quoteCard;
    }
    const labels = cs[card.storyKey];
    const quoteCard: QuoteCardData = {
      ...base,
      type: 'quote',
      quoteText: labels.quote?.text ?? '',
      personName: labels.quote?.name,
      personRole: labels.quote?.role,
      photoUrl: card.quotePhotoUrl,
    };
    return quoteCard;
  }

  const labels = cs[card.storyKey];
  const statCard: StatCardData = {
    ...base,
    type: 'stat',
    headline: cc.tugbaKuruyemis.headline,
    primaryStat: labels.employeeCount ?? '',
    secondaryStat: labels.secondaryStat,
  };
  return statCard;
});
---

<!-- Alt boşluk (2026-08-24, kullanıcı isteği) — carousel'in ok
     butonlarıyla altındaki `LogoStrip`'in kendi üst boşluğu (`py-12`)
     TOPLAMDA fazla boş alan yaratıyordu; üst boşluk (widget'tan ayrım
     için) korunup yalnızca alt boşluk daraltıldı. -->
<section class="mx-auto max-w-[88rem] px-4 pt-12 pb-4 sm:px-6 lg:px-8 lg:pt-16 lg:pb-6">
  <div class="reveal text-center">
    <h2 class="h2-section text-brand">{cc.title}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-body">{cc.intro}</p>
  </div>
  <div class="reveal mt-8" style="transition-delay: 100ms">
    <CustomerStoryCarousel client:visible cards={cards} regionLabel={cc.title} prevLabel={cc.prevLabel} nextLabel={cc.nextLabel} />
  </div>
</section>
