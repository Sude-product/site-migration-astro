---
// "Kullanıcı Dostu Panel" — bkz. docs/homepage-sections-report.md §8.
// 2026-08-20: bu bölümdeki 2. lead-capture formu (hero'dakiyle aynı
// alanlara sahip `HeroForm.tsx` reuse'u) kullanıcı isteğiyle kaldırıldı
// — dashboard görseli + açıklama/checklist metni kaldı, form YOK artık.
import { getTranslations } from '../i18n';
import { HOME_PANEL_IMAGE } from '../data/homeContent';
import type { Locale } from '../data/nav';

const locale = (Astro.currentLocale ?? 'tr') as Locale;
const t = getTranslations(locale);
const { panel } = t.home;
const image = HOME_PANEL_IMAGE[locale];
---

<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
  <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
    <div>
      <img
        src={image.url}
        alt={panel.imageAlt}
        loading="lazy"
        width={image.width}
        height={image.height}
        class="reveal w-full rounded-2xl object-cover"
      />
    </div>
    <div>
      <h2 class="h2-section text-heading">{panel.title}</h2>
      <p class="mt-4 text-body">{panel.text}</p>

      <ul class="mt-5 space-y-2">
        {
          panel.features.map((feature) => (
            <li class="flex items-center gap-2 text-sm font-medium text-heading">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4 shrink-0 text-brand"
                aria-hidden="true"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {feature}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
