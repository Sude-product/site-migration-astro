---
import type { SectorBlock } from '../data/sectorContent';

interface Props extends SectorBlock {}

const { title, text, ctaText, ctaUrl, image } = Astro.props;
---

<div class="flex flex-col rounded-2xl border border-gray-100 bg-surface p-6 shadow-sm">
  {
    image ? (
      <img src={image.url} alt="" loading="lazy" class="h-14 w-14 object-contain" />
    ) : (
      <div class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-light text-brand" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
          <path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.1-1.01L12 2z" />
        </svg>
      </div>
    )
  }
  <h3 class="mt-4 text-xl font-semibold text-heading">{title}</h3>
  <p class="mt-2 flex-1 text-base leading-relaxed text-body">{text}</p>
  {
    ctaText && ctaUrl && (
      <a href={ctaUrl} class="mt-4 inline-flex w-fit items-center text-base font-semibold text-brand hover:underline">
        {ctaText}
      </a>
    )
  }
</div>
