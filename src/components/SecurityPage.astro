---
// Güvenlik sayfası — numaralı belge/link listesi (bkz. `miscPagesContent.ts`).
// Bazı öğeler iç sayfaya (KVKK), bazıları gerçek PDF dokümanlarına gidiyor
// (dış link, target=_blank) — kaynakta da aynı karışık yapı var.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { buildIdenfitTitle } from '../data/pageTitle';
import type { SecurityItem } from '../data/miscPagesTranslationOverrides';
import type { Locale } from '../data/nav';

interface Props {
  title: string;
  /** `<title>` etiketi için — verilmezse `title`'a düşer (bkz. `getSecurityMeta()`). */
  pageTitle?: string;
  /** Meta description — verilmezse `title`'a düşer. */
  description?: string;
  items: SecurityItem[];
  localeUrls: Record<string, string | undefined>;
}

const { title, pageTitle, description, items, localeUrls } = Astro.props;
const locale = (Astro.currentLocale ?? 'tr') as Locale;

function isExternal(url: string) {
  return /^https?:\/\//.test(url);
}
// PDF'ler `deepRelativizeWpUrls()` turunda (Açık nokta #45) mutlak
// `https://idenfit.com/wp-content/...`'ten göreli `/wp-content/...`'a
// çevrildi (hotlink temizliği) — bu, `isExternal()`'ı false'a düşürüp
// bu linklerin `getRelativeLocaleUrl()`'e (Astro SAYFA rotaları içindir,
// statik dosya DEĞİL) düşmesine yol açtı: fonksiyon PDF uzantısının
// sonuna bir `/` ekleyip linki kırıyordu (`bilgi_guvenligi.pdf/` — dosya
// sistemde `/`SİZ duruyor, 404). `/wp-content/` altındaki her şey statik
// bir varlık (asset), Astro sayfa rotası değil — locale önekleme/
// trailing-slash mantığından muaf tutulmalı.
function isStaticAsset(url: string) {
  return url.startsWith('/wp-content/');
}
function resolveHref(url: string) {
  return isExternal(url) || isStaticAsset(url) ? url : getRelativeLocaleUrl(locale, url);
}

// `pageTitle ?? title` bazı dillerde 50 karakterin altında/üstünde olabilir
// (2026-08-10 title uzunluk denetimi) — bkz. `buildIdenfitTitle()`.
const seoTitle = buildIdenfitTitle(pageTitle ?? title, locale);
---

<!-- NL'de kaynak sayfa yok (bkz. `getSecurityLocaleUrls()`'in NL→EN alias
     yorumu, `miscPagesContent.ts`) — hreflang bu yüzden yalnızca gerçek
     3 dili bildiriyor (2026-08-17, "No hreflang tags" SEO turu). -->
<BaseLayout
  title={seoTitle}
  description={description ?? title}
  localeUrls={localeUrls}
  hreflangLocales={['tr', 'en', 'it']}
  breadcrumb={[{ label: title }]}
>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <h1 class="text-3xl font-bold text-heading sm:text-4xl">{title}</h1>

    <ol class="mt-8 divide-y divide-gray-100 border-t border-gray-100">
      {
        items.map((item, i) => (
          <li class="flex items-center justify-between gap-4 py-4">
            <span class="text-body">
              <span class="mr-2 font-semibold text-heading">{i + 1}.</span>
              {item.title}
            </span>
            <a
              href={resolveHref(item.url)}
              target={isExternal(item.url) || isStaticAsset(item.url) ? '_blank' : undefined}
              rel={isExternal(item.url) || isStaticAsset(item.url) ? 'noopener noreferrer' : undefined}
              class="shrink-0 text-sm font-semibold text-brand hover:underline"
            >
              {item.linkText || (isExternal(item.url) || isStaticAsset(item.url) ? 'PDF' : '→')}
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
