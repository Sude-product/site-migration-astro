---

<!-- NL'de kaynak sayfa yok (bkz. `getFaqLocaleUrls()`'in NL→EN alias
     yorumu) — hreflang bu yüzden yalnızca gerçek 3 dili bildiriyor
     (2026-08-17, "No hreflang tags" SEO turu). -->
<BaseLayout title={buildIdenfitTitle(title, locale)} description={t.faqPage.metaDescription} localeUrls={localeUrls} hreflangLocales={['tr', 'en', 'it']}>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <h1 class="text-3xl font-bold text-heading sm:text-4xl">{title}</h1>
      {
        pdfUrl && (
          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex shrink-0 items-center gap-2 rounded-md border border-gray-200 px-4 py-2 text-sm font-semibold text-heading transition-colors hover:border-brand hover:text-brand"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 shrink-0" aria-hidden="true">
              <path d="M12 3v12" />
              <path d="m7 10 5 5 5-5" />
              <path d="M5 21h14" />
            </svg>
            {t.faqPage.pdfLabel}
          </a>
        )
      }
    </div>

    <div class="mt-10 flex flex-col gap-10 lg:flex-row lg:gap-14">
      <!-- Sol: kategori sekmeleri -->
      <div class="flex flex-col gap-6 lg:w-[30%] lg:gap-10" role="tablist">
        {
          categories.map((category, i) => {
            const icon = CATEGORY_ICONS[i % CATEGORY_ICONS.length];
            return (
              <button
                type="button"
                class:list={['faq-tab-btn group flex items-center gap-3 text-left lg:flex-col lg:items-start lg:gap-2', i === 0 && 'is-active']}
                data-faq-tab={`faq-tab-${i}`}
                role="tab"
                aria-selected={i === 0}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox={icon.viewBox}
                  fill="currentColor"
                  aria-hidden="true"
                  class="h-6 w-6 shrink-0 text-[#455a64] group-[.is-active]:text-brand"
                >
                  <path d={icon.path} />
                </svg>
                <span class="font-light text-muted group-[.is-active]:font-medium group-[.is-active]:text-brand lg:text-lg">
                  {category.name}
                </span>
              </button>
            );
          })
        }
      </div>

      <!-- Sağ: aktif kategorinin soru+cevapları (accordion YOK, kaynakla aynı) -->
      <div class="lg:w-[70%]">
        {
          categories.map((category, i) => (
            <div id={`faq-tab-${i}`} class:list={['faq-tab-panel space-y-8', i !== 0 && 'hidden']} role="tabpanel">
              <!-- "Few H2 subheadings" SEO bulgusu (2026-08-17) — 6 kategorinin
                   HER BİRİ DOM'da gerçekten var (yalnızca CSS `hidden` ile
                   gizli, bkz. yukarıdaki class:list), ama kategori adı
                   önceden yalnızca sol sekme butonundaki bir span öğesiydi,
                   sağ panelde hiç heading yoktu. Sorular zaten H3 seviyesi
                   (birebir kaynak yapı) — kategori adı üstlerine gerçek bir
                   H2 olarak eklendi, doğru H2→H3 hiyerarşisi kuruluyor.
                   ⚠️ Bu yorumun kendisi "H2"/"H3" gibi köşeli parantezsiz
                   kelimeler kullanıyor — `check-heading-hierarchy.mjs`'in
                   naif regex'i (`<h([1-6])`) köşeli parantezli bir yazım
                   yakalar, bu yüzden köşeli parantez KULLANILMADI (ilk
                   denemede tam bu sebeple sahte bir "H1→H3" atlaması
                   raporlanmıştı, kendi kendine yanıltma). -->
              <h2 class="text-2xl font-bold text-heading">{category.name}</h2>
              {category.items.map((item) => (
                <div>
                  <h3 class="relative pl-5 text-lg font-bold text-heading before:absolute before:left-0 before:content-['•']">
                    {item.question}
                  </h3>
                  <div class="mt-2 text-sm leading-relaxed text-body [&_p]:mb-2 [&_p:last-child]:mb-0" set:html={item.answer} />
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <script src="../scripts/faq-tabs.js"></script>
</BaseLayout>
