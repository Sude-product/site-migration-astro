---
// SSS sayfası — idenfit.com'un GERÇEK canlı `/sss/` sayfasının yapısı
// birebir yeniden üretildi (önceki implementasyon yanlışlıkla accordion
// kullanmıştı — kaynakta accordion YOK). Canlı sayfanın kendi HTML/CSS/JS'i
// incelenip (`.faq-tabs`/`.faq-tab-btn`/`.faq-tab-content` sınıfları,
// gömülü `<style>`/`<script>` blokları) birebir doğrulandı:
// - Sol: 6 kategori sekmesi (ikon + isim), tıklanınca sağdaki panel değişir
//   (kaynaktaki "aktif sekmeye active class ekleme" mantığı
//   `src/scripts/faq-tabs.js`'te AYNEN uygulandı).
// - Sağ: aktif kategorinin soru+cevapları DOĞRUDAN AÇIK (accordion yok,
//   kaynakta da `.faq-question`/`.faq-answer` her zaman görünür).
// - Üstte "PDF İNDİR" butonu — kaynakta gerçek bir PDF linki var (bkz.
//   `faqContent.ts`), placeholder değil.
// İkonlar idenfit.com'dan birebir kopyalanan 6 gerçek inline SVG (`class=
// "cls-1"` yerine `fill="currentColor"` kullanıldı ki Tailwind'in
// `group-[.is-active]:text-brand` deseniyle renk değişimi CSS ile
// yönetilebilsin — kaynakta bu ayrı bir `<style>` bloğuyla yapılıyordu,
// burada Tailwind utility'leriyle eşdeğeri kuruldu).
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslations } from '../i18n';
import { getFaqCategories, getFaqLocaleUrls, getFaqPdfUrl } from '../data/faqContent';
import { buildIdenfitTitle } from '../data/pageTitle';
import type { Locale } from '../data/nav';

const locale = (Astro.currentLocale ?? 'tr') as Locale;
const t = getTranslations(locale);
const categories = getFaqCategories(locale);
const localeUrls = getFaqLocaleUrls();
const title = t.footer.links.general.faq;
const pdfUrl = getFaqPdfUrl(locale);

