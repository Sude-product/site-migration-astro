---
// İK hub/dizin sayfası (İnsan Kaynakları Modülleri, İşgücü Yönetimi) —
// idenfit.com'un gerçek `page` post type içeriğinden, ama ProductPage'in
// hero+section şemasına UYMAYAN bir düzen: hero + tanıtım bloğu + "ürün
// tile grid" (bkz. `src/data/hubContent.ts`, `scripts/extract-hubs.mjs`,
// CLAUDE.md "İK Hub sayfaları — GERÇEK İÇERİK UYGULANDI"). Bilinçli olarak
// ProductPage'e zorlanmadı, ayrı bir basit component.
import BaseLayout from '../layouts/BaseLayout.astro';
import HubTileCard from './HubTileCard.astro';
import { getTranslations } from '../i18n';
import { buildIdenfitTitle, buildCtaAnchorText, isGenericCtaText } from '../data/pageTitle';
import type { getHubContent } from '../data/hubContent';
import type { Locale } from '../data/nav';

interface Props {
  content: NonNullable<ReturnType<typeof getHubContent>>;
  pageTitle: string;
  localeUrls: Partial<Record<Locale, string>>;
  /** hreflang için GERÇEK içeriği olan locale listesi — bkz.
   * `BaseLayout.astro`'daki `hreflangLocales` prop yorumu. Bu component 2
   * hub ailesi tarafından paylaşılıyor (`getHubLocaleUrls()` NL'i EN'e
   * alias'lıyor, hreflang için güvenilmez) — çağıran sayfa geçirmeli. */
  hreflangLocales?: Locale[];
}

const { content, pageTitle, localeUrls, hreflangLocales } = Astro.props;
const { hero, intro, tiles, faq } = content;

const locale = (Astro.currentLocale ?? 'tr') as Locale;
const t = getTranslations(locale);
const description = hero.text.replace(/<[^>]+>/g, '').slice(0, 160);
// `pageTitle` bazı hub sayfalarında 50 karakterin altında (2026-08-10
// title uzunluk denetimi) — bkz. `buildIdenfitTitle()`.
const title = buildIdenfitTitle(pageTitle, locale);
// CTA/anchor text optimizasyonu (2026-08-12) — bkz. `ProductPage.astro`'daki
// AYNI mantığın yorumu. Tamamen otomatik — 2 hub grubunun (6 sayfa) hiçbiri
// 60 karakter sınırını aşmıyor (keşif turunda doğrulandı), override
// prop'u GEREKMİYOR.
const heroCtaText = hero.ctaText && isGenericCtaText(hero.ctaText) ? buildCtaAnchorText(pageTitle, locale) : hero.ctaText;
// Başlık seviye atlaması düzeltmesi (2026-08-13, "Başlık hiyerarşisi
// sıralı değil" SEO uyarısı — bkz. CLAUDE.md). "Tanıtım bloğu" (H2)
// `intro && intro.title` koşuluna bağlı render ediliyor (altta) — o blok
// hiç yoksa tile grid'in başlıkları normalde H3 olarak H1'in HEMEN
// ALTINA düşüp bir seviye atlaması (H1→H3) yaratırdı. `intro` yoksa
// `HubTileCard`'a `headingLevel="h2"` geçirilip bu atlama önleniyor —
// `intro` VARSA (çoğu hub/dil) davranış DEĞİŞMEDİ, tile'lar hâlâ H3
// (intro'nun H2'sinin altında doğru nested).
const tileHeadingLevel = intro && intro.title ? 'h3' : 'h2';
---

<BaseLayout title={title} description={description} localeUrls={localeUrls} hreflangLocales={hreflangLocales}>
  <!-- Hero -->
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
      <div>
        <h1 class="text-3xl font-bold leading-tight tracking-tight text-heading sm:text-4xl lg:text-5xl" set:html={hero.title} />
        {hero.text && <p class="mt-5 max-w-xl text-lg text-body" set:html={hero.text} />}
        {
          hero.ctaText && hero.ctaUrl && (
            <a
              href={hero.ctaUrl}
              class="btn-cta mt-8 inline-flex items-center justify-center px-8 py-3 text-sm font-semibold"
            >
              {heroCtaText}
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- Tanıtım bloğu (varsa) -->
  {
    intro && intro.title && (
      <section class="bg-brand-light py-12 lg:py-20">
        <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
          <h2 class="h2-section text-heading" set:html={intro.title} />
          <div class="mt-4 text-body [&_p]:mb-2 [&_p:last-child]:mb-0" set:html={intro.text} />
        </div>
      </section>
    )
  }

  <!-- Ürün tile grid (veri kaynaklı, sabit sayı değil) -->
  {
    tiles.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {tiles.map((tile) => (
            <HubTileCard {...tile} headingLevel={tileHeadingLevel} />
          ))}
        </div>
      </section>
    )
  }

  <!-- SSS (varsa — bkz. KARAR 1, kaynak sitede olduğu gibi gösterilir) -->
  {
    faq.length > 0 && (
      <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
        <h2 class="h2-section text-heading">{t.mega.urunler.intro.faqLink}</h2>
        <div class="mt-6 divide-y divide-gray-100">
          {faq.map((item) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-heading marker:content-none">
                <span>{item.question}</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 12 12"
                  fill="none"
                  aria-hidden="true"
                  class="h-3 w-3 shrink-0 transition-transform group-open:rotate-180"
                >
                  <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <div class="mt-3 text-sm text-body [&_p]:mb-2 [&_p:last-child]:mb-0" set:html={item.answer} />
            </details>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
