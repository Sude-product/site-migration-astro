---
// Online Sunum Talebi (Request Online Presentation) — sitedeki HER "Online
// Sunum Talebi"/"Get Started" CTA'sının gittiği ortak sayfa (bkz.
// `miscPagesContent.ts`'teki canonical slug notu).
//
// ⚠️ YENİDEN TASARIM (2026-08-29, kullanıcı talimatı): önceki tur bu
// sayfayı kaynağın (idenfit.com/online-sunum-talep-et/) BİREBİR gerçek DOM
// yapısına (2 kolon: şeffaf sol kolon + kırmızı arka plan + sağ beyaz form
// kartı) sadık kalarak kurmuştu — o kaynak-sadakati kullanıcı isteğiyle
// BİLİNÇLİ olarak terk edildi. Yeni tasarım üç kaynağın harmanı:
// 1. Kullanıcının paylaştığı bir mockup/artifact (ortalanmış hero + radyal
//    gradyan alt ton + özellik "chip" şeridi + arka planda hafif
//    donuklaştırılmış bir sahne üzerinde YÜZEN beyaz form kartı).
// 2. `/demo` (Landing Page) sayfasının 2 ADIMLI form deseni
//    (`LandingRequestForm.tsx`) — AYNI iskelet, yalnızca alan GRUBU/SIRASI
//    kullanıcı talimatıyla değişti (bkz. `PresentationRequestForm.tsx`).
// 3. `/demo`'nun form kartının ARKASINDAKİ hareketli/nabız dekorasyonu
//    (`LandingPulseDecoration.tsx`, AYNEN yeniden kullanıldı — "hareketli
//    panel" talebi buradan karşılanıyor, yeni bir animasyon İCAT EDİLMEDİ).
//
// ⚠️ İKİNCİ TUR (2026-08-29, aynı gün, kullanıcı geri bildirimi):
// 1. Başlık ile form kartı arasındaki "chip" şeridi (`content.info`'nun 3
//    maddesi) ve sayfa altındaki 2 logo şeridi (`referencesImage`/
//    `integrationsImage`, "Siz de bize güvenen..."/"Entegre
//    Çalışabileceğimiz Sistemler") kaldırıldı — sadeleştirme talebi.
//    `content.info`/`referencesText`/`referencesImage`/`integrationsText`/
//    `integrationsImage` alanları hâlâ `PresentationContent` tipinde/veri
//    kaynağında duruyor (silinmedi, yalnızca bu sayfada render edilmiyor).
// 2. `/demo`'daki "3 Adımda idenfit" (`LandingTimeline.astro`) ve "Öne
//    Çıkan Özellikler" (`LandingBentoGrid.astro`) bölümlerinin İÇERİĞİ
//    (metin birebir aynı, yeni iddia YOK) bu sayfaya özel, daha zarif bir
//    tasarımla eklendi (`PresentationTimeline.astro`/
//    `PresentationFeatureGrid.astro`) — kart yüzeyleri + idenfit'in gerçek
//    logo yıldızı (`IdenfitStar`, Müşteri Hikayeleri carousel'indeki AYNI
//    `idenfit-star-spin` dönen-yıldız deseni, kullanıcı talimatı "yıldızı
//    tasarıma dahil et").
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingPulseDecoration from './LandingPulseDecoration.tsx';
import PresentationRequestForm from './PresentationRequestForm.tsx';
import PresentationTimeline from './PresentationTimeline.astro';
import PresentationFeatureGrid from './PresentationFeatureGrid.astro';
import LastUpdated from './LastUpdated.astro';
import { getTranslations } from '../i18n';
import { getKvkkAndTermsHrefs, getPresentationMetaDescription, type PresentationContent } from '../data/miscPagesContent';
import { getThankYouLocaleUrls } from '../data/thankYouContent';
import { buildIdenfitTitle } from '../data/pageTitle';
import type { Locale } from '../data/nav';

interface Props {
  content: PresentationContent;
  /** "No visible content dates" GEO bulgusu (2026-08-17) — bkz.
   * `LastUpdated.astro`. */
  modified?: Date;
}

const { content, modified } = Astro.props;
const locale = (Astro.currentLocale ?? 'tr') as Locale;
const t = getTranslations(locale);
const { kvkkHref, termsHref } = getKvkkAndTermsHrefs(locale);
const description = getPresentationMetaDescription(locale) ?? content.pageTitle.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const title = buildIdenfitTitle(content.formTitle, locale);

const thankYouUrls = getThankYouLocaleUrls();
const redirectHref = thankYouUrls[locale] ?? thankYouUrls.tr ?? '/tesekkurler/';
---

<BaseLayout title={title} description={description} dateModified={modified?.toISOString()} breadcrumb={[{ label: content.formTitle }]}>
  <section
    class="relative isolate overflow-hidden py-16 lg:py-20"
    style="background: radial-gradient(120% 90% at 50% 0%, #FFDCDC 0%, #FFF3F3 42%, #FFFFFF 78%);"
  >
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h1 class="text-3xl font-bold leading-tight text-heading lg:text-[44px] lg:leading-[1.16]" set:html={content.pageTitle} />

      {
        content.phoneNumber && (
          <p class="mt-7 text-sm font-semibold text-muted">
            {content.callText}
            <a href={content.phoneNumberLink} class="ml-2 inline-flex items-center gap-1.5 font-bold text-[#C40000] hover:underline">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4 shrink-0"
                aria-hidden="true"
              >
                <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
              </svg>
              {content.phoneNumber}
            </a>
          </p>
        )
      }
    </div>

    <div class="relative mx-auto mt-14 flex max-w-md justify-center px-6">
      <LandingPulseDecoration client:visible />
      <div class="relative z-10 w-full rounded-[22px] border border-[#F0E4E4] bg-white p-9 shadow-[0_24px_60px_-20px_rgba(120,0,0,0.28)] lg:p-10">
        <h2 class="text-center text-2xl font-bold text-heading">{content.formTitle}</h2>
        <p class="mt-2.5 mb-6 text-center text-sm leading-relaxed text-muted">{content.formText}</p>

        <PresentationRequestForm
          client:load
          idPrefix="presentation"
          locale={locale}
          redirectHref={redirectHref}
          labels={{
            email: t.hero.presentationForm.email,
            company: t.hero.presentationForm.company,
            phone: t.hero.presentationForm.phone,
            phoneError: t.hero.formPhoneError,
            phoneCountryLabel: t.hero.formPhoneCountryLabel,
            phoneCountrySearchPlaceholder: t.hero.formPhoneCountrySearchPlaceholder,
            phoneCountryNoResults: t.hero.formPhoneCountryNoResults,
            name: t.hero.presentationForm.name,
            next: t.hero.presentationForm.next,
            back: t.hero.presentationForm.back,
            submit: t.hero.formSubmit,
            kvkkNotice: t.hero.kvkkNotice,
          }}
          kvkkHref={kvkkHref}
          termsHref={termsHref}
        />
      </div>
    </div>
  </section>

  <PresentationTimeline />
  <PresentationFeatureGrid />

  <div class="py-8 text-center">
    <LastUpdated date={modified} locale={locale} />
  </div>
</BaseLayout>

<!-- `PresentationTimeline`/`PresentationFeatureGrid`'in `.reveal` scroll-fade'i
     için (bkz. `LandingPage.astro`'daki AYNI kullanım) — `BaseLayout.astro`
     bu script'i KENDİLİĞİNDEN yüklemiyor, yalnızca `.reveal`'ın JS-kapalı
     `<noscript>` geri düşüşünü tanımlıyor; script'in kendisi onu gerçekten
     kullanan her sayfada/component'te ayrı eklenmeli. -->
<script src="../scripts/scroll-reveal.js"></script>
