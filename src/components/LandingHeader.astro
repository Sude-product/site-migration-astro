---
// Landing Page (`/demo`) — minimal header. Mega-menü/mobil menü/dil
// değiştirici YOK (kullanıcı kararı: ziyaretçiyi siteye dağıtacak hiçbir
// link olmasın, tek CTA form olsun, bkz. CLAUDE.md 2026-08-06 günlüğü).
// `Header.astro`'ya "minimal mod" dalı eklemek yerine bağımsız bir
// component (mega-menü component'i regresyon riski taşımadan, tek sayfa
// için yeterli basitlikte).
import IdenfitLogo from './icons/IdenfitLogo.tsx';

// Telefon numarası `src/data/footer.ts`'teki `FOOTER_CONTACT` ile AYNI —
// yeni bir numara uydurulmadı.
const PHONE_LABEL = '+90 216 295 09 27';
const PHONE_HREF = 'tel:+902162950927';
---

<header class="border-b border-black/5 bg-surface">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="shrink-0 text-heading" aria-label="idenfit — Anasayfa">
      <IdenfitLogo className="h-[50px] w-auto" />
    </a>
    <a
      href={PHONE_HREF}
      class="flex items-center gap-2 text-sm font-medium text-heading transition-colors hover:text-brand sm:text-base"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5 shrink-0 text-brand"
        aria-hidden="true"
      >
        <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
      </svg>
      {PHONE_LABEL}
    </a>
  </div>
</header>
