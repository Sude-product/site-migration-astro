---
// Sertifika/kalite rozet şeridi — idenfit.com ana sayfasından (bkz.
// docs/homepage-sections-report.md §10). Metin ISO 27001/9001'i açıkça
// adlandırıyor, ama 7 rozetin kaynak sitedeki `alt` metni zaten anlamsız
// (`icon5`..`icon11`) ve SVG path'lerinden hangi spesifik sertifikayı
// temsil ettikleri güvenilir şekilde teşhis edilemedi — bu yüzden rozetler
// burada DEKORATİF kabul edilip `alt=""` ile render ediliyor (metindeki
// ISO 27001/9001 bilgisi zaten erişilebilir gerçek metin olarak sunuluyor).
//
// DÜZELTME (2026-07-22): kaynak sitenin gerçek CSS'i (post-9.css)
// incelendiğinde rozetlerin çıplak sayfa zemininde DEĞİL, `#FFE5E5` açık
// pembe (FeatureGrid'in 1. kart ikonuyla aynı ton — bkz. `FeatureGrid.astro`),
// `border-radius:10px`, padding'li bir kutu İÇİNDE gösterildiği görüldü —
// ilk implementasyon bu kutuyu atlayıp ikonları çıplak zeminde + opacity-80
// ile soluk göstermişti.
//
// DÜZELTME (2026-08-21, kullanıcı bulgusu): rozetler kaynağa göre KÜÇÜK
// duruyordu. idenfit.com'da bu 7 ikon (`icon5`..`icon11`) canlı DOM'da
// ölçüldü — masaüstünde (1536px) DAHİ mobil (400px) ile TAMAMEN AYNI
// piksel yükseklikte (41-90px arası, hiç responsive KÜÇÜLTME/büyütme
// yok). Bizim önceki `h-8 sm:h-10` (32/40px) kaynağın ortalama ~60px'inin
// yaklaşık yarısıydı — `h-10 sm:h-14`'e (40/56px) çıkarıldı, kaynağın
// TEK sabit boyutunu birebir kopyalamak yerine (bizim object-contain +
// tek-yükseklik deseni farklı en-boy oranlı 7 ikonu zaten tutarlı
// gösteriyor) sitenin genel responsive ilkesiyle uyumlu kaldı.
import { getTranslations } from '../i18n';
import { CERTIFICATION_BADGE_URLS } from '../data/homeContent';

const t = getTranslations(Astro.currentLocale ?? 'tr');
const { certifications } = t.home;
---

<section class="mx-auto max-w-5xl px-4 py-12 text-center sm:px-6 lg:px-8 lg:py-16">
  <h2 class="h2-section text-heading">
    {certifications.titleLine1}
    <br />
    {certifications.titleLine2}
  </h2>
  <p class="mx-auto mt-4 max-w-4xl text-lg text-body">{certifications.text}</p>

  <div
    class="mx-auto mt-8 flex max-w-4xl flex-wrap items-center justify-center gap-x-8 gap-y-6 rounded-[10px] bg-[#FFE5E5] px-8 py-8 sm:px-16"
    aria-hidden="true"
  >
    {
      CERTIFICATION_BADGE_URLS.map((url) => (
        <img src={url} alt="" loading="lazy" class="h-10 w-auto object-contain sm:h-14" />
      ))
    }
  </div>
</section>
