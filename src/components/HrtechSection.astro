---
// HRTech Alliance partner vurgusu — bkz. docs/homepage-sections-report.md
// §12. Kaynak sitedeki gibi dış link, 4 dilde aynı (yeni sekmede açılır).
import { getTranslations } from '../i18n';
import { HRTECH_ALLIANCE_URL, HRTECH_LOGO_URL, HOME_HRTECH_IMAGE } from '../data/homeContent';
import type { Locale } from '../data/nav';

const locale = (Astro.currentLocale ?? 'tr') as Locale;
const t = getTranslations(locale);
const { hrtech } = t.home;
const image = HOME_HRTECH_IMAGE[locale];
---

<!-- Kaynakta bu bölümü saran container'ın (`elementor-element-131cd29`)
     27px kalınlığında, `uicore_secondary` (projemizin `secondary` moru,
     #6F2C90) renkli bir ÜST KENARLIĞI var (`post-9.css`: `border-width:
     27px 0px 0px 0px`) — AMA kaynakta bu container `e-con-boxed`
     (`--content-width:1440px`'e sınırlı), `max-w-7xl`imiz (1280px) içine
     koyunca geniş ekranlarda hem kaynaktan daha dar hem de "kısa"
     görünüyordu (2026-07-28, kullanıcı bulgusu — ikinci düzeltme turu).
     Kaynağın 1440px kutusu da geniş ekranlarda zaten tam viewport
     doldurmuyordu; bu yüzden şerit BİLİNÇLİ OLARAK ayrı, tam viewport
     genişliğinde (`w-full`, `<main>`'in kendisi paddingsiz olduğu için
     ek bir "full-bleed" hack'i gerekmiyor) bir öğeye taşındı — sayfanın
     GERÇEK sınırlarına kadar uzanan, kesintisiz bir şerit. Testimonial
     bölümünden biraz daha ayrışsın diye üstüne `mt-8 lg:mt-12` eklendi. -->
<div class="mt-8 h-[27px] w-full bg-secondary lg:mt-12" aria-hidden="true"></div>
<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
  <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
    <div>
      <a href={HRTECH_ALLIANCE_URL} target="_blank" rel="noopener noreferrer" class="block w-fit">
        <img src={HRTECH_LOGO_URL} alt="HRTech Alliance" loading="lazy" class="h-8 w-auto object-contain" />
      </a>
      <h2 class="h2-section mt-5 text-heading">{hrtech.title}</h2>
      <p class="mt-4 text-body">{hrtech.text}</p>
      <a
        href={HRTECH_ALLIANCE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex items-center text-sm font-semibold text-brand hover:underline"
      >
        hrtech-alliance.com
      </a>
    </div>
    <img
      src={image.url}
      alt={hrtech.title}
      loading="lazy"
      width={image.width}
      height={image.height}
      class="reveal mx-auto w-full max-w-xs rounded-2xl object-cover"
    />
  </div>
</section>
