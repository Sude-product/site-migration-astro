---
// Ürün/modül sayfası (Bordro, PDKS, İzin vb.) — idenfit.com'un gerçek
// `page` post type içeriğinden (bkz. `src/data/productContent.ts`,
// `reference/wordpress-export/products.json`, `scripts/extract-products.mjs`).
// Sektör sayfalarıyla aynı desen: BaseLayout + per-sayfa gerçek locale
// URL'leri (dil değiştirici düzeltmesi) + CTA URL'lerinin kendi route
// şemamıza göre yeniden çözülmesi.
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildFaqJsonLd } from '../data/faqJsonLd';
import { organizationId, safeJsonLd } from '../data/jsonLd';
import ProductSectionBlock from './ProductSectionBlock.astro';
import LastUpdated from './LastUpdated.astro';
import { getTranslations } from '../i18n';
import { buildIdenfitTitle, buildCtaAnchorText, isGenericCtaText } from '../data/pageTitle';
import type { getProductContent } from '../data/productContent';
import type { Locale } from '../data/nav';

/** Bölüm-seviyesi CTA override'ı (2026-08-12, Puantaj sayfası — bkz.
 * `sectionCtaOverrides` prop yorumu). `ctaUrl` opsiyonel: yalnızca
 * kaynakta o bölümün HİÇ CTA'sı yoktu (boş `ctaText`/`ctaUrl`) ve YENİ
 * bir CTA ekleniyorsa gerekir; kaynakta zaten bir CTA varsa (yalnızca
 * metni değişiyorsa) verilmeyebilir, mevcut `ctaUrl` korunur. */
interface SectionCtaOverride {
  ctaText: string;
  ctaUrl?: string;
}

interface Props {
  content: NonNullable<ReturnType<typeof getProductContent>>;
  pageTitle: string;
  localeUrls: Partial<Record<Locale, string>>;
  /** hreflang için GERÇEK içeriği olan locale listesi — bkz.
   * `BaseLayout.astro`'daki `hreflangLocales` prop yorumu. Standart ürün/
   * modül sayfalarının HEPSİ için (`getProductLocaleUrls()` alias'lamaz,
   * `SLUG_INDEX`'te gerçekten VAR olan locale'leri döner) verilmezse
   * VARSAYILAN (LOCALES, hepsi) doğru — yalnızca Demirbaş/Seyahat (TR+EN)/
   * Puantaj (TR) gibi GERÇEKTEN kısıtlı sayfalar bunu elle geçirmeli. */
  hreflangLocales?: Locale[];
  /** Meta description override — `hero.text` bazı sayfalarda 70 karakterden
   * kısa çıkıyor (2026-08-10 denetimi, bkz. CLAUDE.md); verilmezse eski
   * `hero.text` davranışına düşer (`SecurityPage.astro` ile AYNI opt-in
   * desen — mevcut ürün/modül sayfalarının çoğu zaten 70+ karakter,
   * DOKUNULMADI). */
  description?: string;
  /** `<title>` override — `buildIdenfitTitle(pageTitle, locale)` bazı
   * sayfalarda (`pageTitle` ÇOK UZUN, ör. Donanım'ın İngilizce/İtalyanca/
   * Felemenkçe hero cümlesi) 60 karakteri aşan bir sonuç üretebilir;
   * otomatik kırpma güvenli olmadığı için bu durumlarda çağıran sayfa
   * elle kısa bir başlık geçirir (2026-08-10 title uzunluk denetimi). */
  title?: string;
  /** CTA anchor text override (2026-08-12, CTA/anchor text optimizasyonu —
   * bkz. `pageTitle.ts`'in `buildCtaAnchorText()` yorumu). Hero CTA'sı
   * (`hero.ctaText`) jenerik bir metinse (`isGenericCtaText()`) varsayılan
   * olarak `pageTitle` anahtar kelime olarak kullanılır; `pageTitle`
   * kendisi uzun bir tanıtım cümlesiyse (ör. Donanım/Demirbaş) bu prop'la
   * daha kısa, elle seçilmiş bir anahtar kelime geçirilebilir — `title`
   * override'ıyla AYNI kurulmuş desen (keşif turunda 150 sayfadan yalnızca
   * 5'inin buna ihtiyacı olduğu doğrulandı). */
  ctaKeyword?: string;
  /** Tam CTA metni override'ı (2026-08-12, kullanıcı kararı — Puantaj
   * sayfası) — `ctaKeyword`'den FARKI: `ctaKeyword` yalnızca kaynak metin
   * jenerikse devreye girer ve şablonlu ("{keyword} için Başvur") bir
   * sonuç üretir; bu prop VERİLDİĞİNDE kaynağın jenerik olup olmadığına
   * BAKMAKSIZIN, şablonsuz/VERBATİM bu metni gösterir. Kullanıcı kararıyla
   * her sayfada anlamlı ama şablona uymayan (ör. "Zaman Yönetimine
   * Başlayın" gibi "Başlayın" fiilini koruyan) bir metin gerektiğinde
   * kullanılır — `title`/`description`/`ctaKeyword` override'larıyla AYNI
   * ilke, yalnızca en üst öncelikli. */
  ctaTextOverride?: string;
  /** Bölüm-seviyesi CTA override'ları (2026-08-12, Puantaj sayfası —
   * kullanıcı kararıyla, hero'daki AYNI jenerik "Başlayın" metninin
   * SECTION seviyesinde de tekrar ettiği bulundu). Anahtar = `content.sections`
   * dizisindeki 0-tabanlı index. Hero'nun `ctaTextOverride`'ından FARKI:
   * bu, tek bir sayfada BİRDEN FAZLA section'ı AYRI AYRI (farklı metin/
   * gerekirse yeni bir CTA linki) hedefleyebiliyor — `SectionCtaOverride`
   * tipine bkz. */
  sectionCtaOverrides?: Record<number, SectionCtaOverride>;
  /** "No visible content dates" GEO bulgusu (2026-08-17) — bkz.
   * `LastUpdated.astro`. GERÇEK WP `modified` tarihi verilmezse (kaynakta
   * yoksa/sentetik bir sayfaysa) hiçbir şey render edilmez, uydurulmaz. */
  modified?: Date;
  /** `'side'` (varsayılan) — mevcut 2 kolonlu (metin/görsel yan yana) hero.
   * `'stacked'` — ortalanmış metin + ALTINDA görsel + (varsa) `heroPartnerLogo`
   * satırı (2026-09-02, İşe Alım Modülü/Hiringoz — canlı sitede hero artık
   * bu düzeni kullanıyor: H1/paragraf ortalanmış, arka planda dekoratif bir
   * illüstrasyon, altında CTA'nın yanında "hiringoz" marka logosu). Diğer
   * TÜM sayfalarda verilmez, davranış DEĞİŞMEZ. */
  heroLayout?: 'side' | 'stacked';
  /** `heroLayout='stacked'` iken CTA butonunun yanında gösterilen ortak
   * marka logosu (2026-09-02 — canlı sitede hero'daki "hiringoz →" logosu,
   * kendisi bir LİNK değil, yalnızca dekoratif marka rozeti — bkz.
   * `productTranslationOverrides.ts`'teki yorum). */
  heroPartnerLogo?: { url: string; alt: string; width: number; height: number };
  /** Breadcrumb'ın son kırıntı etiketi — verilmezse (varsayılan, diğer
   * TÜM sayfalarda) `pageTitle` kullanılır. `pageTitle` kendisi uzun bir
   * tanıtım cümlesiyse (İşe Alım Modülü/Donanım gibi) H1/breadcrumb'ın
   * İKİSİ DE bu uzun cümleyi göstermesi istenmeyebilir — bu durumda
   * `ctaKeyword` gibi kısa, gerçek bir isim geçirilebilir (2026-09-02,
   * kullanıcı isteği). `title`/`ctaKeyword` override'larıyla AYNI ilke. */
  breadcrumbLabel?: string;
  /** `SoftwareApplication` JSON-LD'si basılsın mı (2026-10-03, Açık nokta
   * #29). VARSAYILAN `true` — bu component'i kullanan sayfaların büyük
   * çoğunluğu gerçek bir ürün/modül.
   *
   * ⚠️ `false` GEÇİRİLMESİ GEREKEN durum: bu component yalnızca ürün/modül
   * sayfaları tarafından DEĞİL, aynı DÜZENİ paylaştıkları için birkaç
   * KURUMSAL/pazarlama sayfası tarafından da kullanılıyor — "Hedef Global
   * Marka" ve "Neden idenfit" aileleri (5+5 sayfa). Bunlar bir yazılım
   * uygulamasını DEĞİL, şirketin 2027 hedefini/değer önerisini anlatıyor;
   * onlara `SoftwareApplication` basmak şema seviyesinde OLGUSAL OLARAK
   * YANLIŞ bir iddia olurdu (ve "Hedef Global Marka"nın hiç bölümü
   * olmadığı için `featureList` de boş çıkıyordu — ilk ölçümde bu şekilde
   * yakalandı). `Donanım` ailesi BİLİNÇLİ OLARAK dışarıda bırakılmadı:
   * o sayfa idenfit PDKS yazılımının donanım entegrasyon YETENEĞİNİ
   * anlatıyor ve `featureList`'i 7 gerçek ürün yeteneği taşıyor. */
  softwareApplication?: boolean;
}

const {
  content,
  pageTitle,
  localeUrls,
  hreflangLocales,
  description: descriptionOverride,
  title: titleOverride,
  ctaKeyword,
  ctaTextOverride,
  sectionCtaOverrides,
  modified,
  heroLayout = 'side',
  heroPartnerLogo,
  breadcrumbLabel,
  softwareApplication = true,
} = Astro.props;
// SSS her zaman gösterilir — kaynak sitedeki içerik olduğu gibi taşınır,
// biz içerik müdahalesi yapmıyoruz (bkz. CLAUDE.md "SSS kararı geri alındı").
// Not: kaynakta bazı sayfalarda SSS başka bir modülle yanlış eşleşmiş
// olabilir (PDKS örneği) — bu bilinçli olarak düzeltilmiyor, aynen
// gösteriliyor.
const { hero, sections, faq } = content;

// FAQPage JSON-LD — `HomeFaqSection.astro`'daki AYNI şekil ve aynı ilke
// (`acceptedAnswer.text` HTML'den arındırılmış düz metin; görsel render
// kaynağın işaretlemesini korumaya devam ediyor).
//
// ⚠️ DÜRÜST BEKLENTİ (2026-09-07): Google FAQ rich result'larını önce
// Ağustos 2023'te devlet/sağlık sitelerine kısıtladı, 7 Mayıs 2026'da ise
// tamamen kaldırdı — yani bu şema arama sonucunda açılır soru-cevap kutusu
// ÜRETMEYECEK. Yine de eklendi çünkü (a) FAQPage geçerli bir schema.org tipi
// olmaya devam ediyor ve LLM tabanlı arama araçları soru-cevap yapısını bu
// işaretlemeden okuyor, (b) maliyeti tek bir component değişikliği: içerik
// zaten sayfada, ikinci bir metin yazılmıyor. Fayda ÖLÇÜLMÜŞ değil,
// spekülatif — bu yüzden düşük öncelikli bir ekleme olarak yapıldı.
const faqJsonLd = buildFaqJsonLd(faq);

const locale = (Astro.currentLocale ?? 'tr') as Locale;
const t = getTranslations(locale);
const description = descriptionOverride ?? hero.text.replace(/<[^>]+>/g, '').slice(0, 160);
const title = titleOverride ?? buildIdenfitTitle(pageTitle, locale);
// CTA/anchor text optimizasyonu (2026-08-12) — bkz. `ctaKeyword`/
// `ctaTextOverride` prop yorumları. Kaynak zaten benzersiz/anlamlı bir
// metin taşıyorsa (jenerik listede yoksa) hiç DOKUNULMAZ.
const heroCtaText =
  ctaTextOverride ?? (hero.ctaText && isGenericCtaText(hero.ctaText) ? buildCtaAnchorText(ctaKeyword ?? pageTitle, locale) : hero.ctaText);

// SoftwareApplication JSON-LD (2026-10-03, Açık nokta #29) — ürün/modül
// sayfalarının tip-özel şeması. ÖNCEDEN bu sayfalar yalnızca jenerik
// `WebPage` (+ site geneli `Organization`/`BreadcrumbList`, varsa `FAQPage`)
// taşıyordu; yani şema seviyesinde bir "İK yazılım modülü" oldukları hiç
// söylenmiyordu. Tek component değişikliği TÜM ürün/modül sayfalarını
// kapsıyor (`ProductPage.astro` 121 sayfa dosyası tarafından kullanılıyor).
//
// TÜM alanlar sayfanın KENDİ var olan içeriğinden türetiliyor — yeni metin
// YAZILMADI (KARAR 1). Alan seçimi ve BİLİNÇLİ eksikler:
//
// - `offers` HİÇ EKLENMEDİ (kullanıcı kararı, 2026-10-03). Bir modül sayfası
//   satın alma birimi DEĞİL; fiyat Fiyatlar sayfasının paketlerine (Mikro/
//   KOBİ/Pro) ait. Mikro gerçekten ücretsiz ama KOBİ ve Pro 2026-09-22'den
//   beri İKİSİ DE "Teklif Al" (bkz. eski Açık nokta #74), yani herkese açık
//   bir fiyatı yok. 121 modül sayfasına `price: "0"` basmak, 22 modülün
//   19'u için OLGUSAL OLARAK YANLIŞ bir fiyat iddiası olurdu.
// - `softwareVersion` ASLA eklenmeyecek (kullanıcı kararı) — SaaS sürekli
//   dağıtılıyor, sabit bir sürüm numarası yok; uydurmak yanlış olur.
// - `aggregateRating`/`review` YOK — gerçek, doğrulanabilir bir
//   derecelendirme verimiz hiç yok, uydurulamaz (ve uydurulsa Google'ın
//   yapılandırılmış veri politikalarını ihlal ederdi).
//
// ⚠️ DÜRÜST BEKLENTİ: Google'ın "Software App" rich result'ı `name` YANINDA
// `offers` VEYA `aggregateRating`/`review` ZORUNLU kılıyor — yukarıdaki üç
// bilinçli eksik yüzünden bu blok arama sonucunda bir uygulama kartı
// ÜRETMEYECEK. Yine de değerli: (a) sayfanın bir yazılım uygulaması olduğunu
// ve hangi kuruluşa ait olduğunu makine-okunur biçimde söylüyor, (b) LLM
// tabanlı arama araçları `featureList`'i okuyor, (c) maliyeti tek bir
// component değişikliği — içerik zaten sayfada. (`FAQPage` bloğundaki AYNI
// dürüstlük notu deseniyle, bkz. yukarısı.)
const IDENFIT_ORG_ID = organizationId(Astro.site);
// `BaseLayout.astro:214`'teki AYNI ifade — `Astro.site` tanımsızken (yalnızca
// yapılandırma kazası) göreli yola düşer.
const productPageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
// `featureList` — sayfanın KENDİ bölüm başlıkları (`content.sections`, yani
// override'lar UYGULANDIKTAN sonraki gerçek render içeriği). Başlıklar
// `set:html` ile basıldığı için işaretleme/`&nbsp;` taşıyabiliyor; etiketler
// temizlenip boşluk daraltılıyor. Boş kalan başlık hiç eklenmiyor.
//
// ÖZELLİK OLMAYAN bölümler indeksle dışlanıyor (2026-10-03) — tanıtım
// ("Neden idenfit") ve kapanış CTA'sı ("Şimdi Başlayın") bölümleri ürün
// ÖZELLİĞİ değil. Dışlama listesi `productContent.ts`'in
// `NON_FEATURE_SECTION_INDEXES`'inde, `trSlug` ile anahtarlı ve locale'den
// bağımsız — metin/regex eşleştirme KULLANILMADI, nedeni o sabitin
// yorumunda (5 dilde 5 farklı metin + Türkçe "İ"nin `/i` bayrağıyla
// eşleşmemesi). **Yalnızca şemayı etkiler, GÖRÜNÜR render DEĞİŞMEZ** —
// bölümler sayfada aynen render edilmeye devam ediyor.
const nonFeatureIndexes = content.nonFeatureSectionIndexes ?? [];
const featureList = sections
  .filter((_, i) => !nonFeatureIndexes.includes(i))
  .map((s) =>
    s.title
      .replace(/<[^>]+>/g, ' ')
      .replace(/&nbsp;/g, ' ')
      .replace(/\s+/g, ' ')
      .trim(),
  )
  .filter((title) => title.length > 0);
// `name`: breadcrumb'ın kullandığı AYNI kaynak — `pageTitle` bazı sayfalarda
// uzun bir tanıtım cümlesi (İşe Alım/Donanım), o sayfalar zaten kısa gerçek
// adı `breadcrumbLabel` ile geçiriyor. İkinci bir isim kaynağı kurulmadı.
// `description`: meta description ile AYNI tek kaynak (yukarıdaki `description`).
const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: breadcrumbLabel ?? pageTitle,
  description,
  url: productPageUrl,
  inLanguage: locale,
  // schema.org enumerasyon değeri (uydurma içerik değil) — idenfit bir
  // kurumsal İK/HR uygulaması.
  applicationCategory: 'BusinessApplication',
  ...(featureList.length > 0 ? { featureList } : {}),
  // Kuruluşu YENİDEN TANIMLAMAK yerine `@id` ile REFERANS (2026-10-02 PR 3
  // ile kurulan desen). `organizationId()` paylaşılan tek kaynak; `site`
  // yoksa alan hiç basılmıyor — tanımsız bir düğüme atıf yapmaktansa
  // alanı hiç yazmamak doğru.
  ...(IDENFIT_ORG_ID ? { publisher: { '@id': IDENFIT_ORG_ID } } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  localeUrls={localeUrls}
  hreflangLocales={hreflangLocales}
  image={hero.image?.url}
  dateModified={modified?.toISOString()}
  breadcrumb={[{ label: breadcrumbLabel ?? pageTitle }]}
>
  {softwareApplication && <script type="application/ld+json" set:html={safeJsonLd(softwareJsonLd)} is:inline />}

  <!-- Hero -->
  {
    heroLayout === 'stacked' ? (
      <section id={hero.id} class="mx-auto max-w-6xl px-4 py-12 text-center sm:px-6 lg:px-8 lg:py-20">
        <h1 class="text-3xl font-bold leading-tight tracking-tight text-brand sm:text-4xl lg:text-5xl" set:html={hero.title} />
        {hero.text && <div class="mx-auto mt-5 max-w-4xl text-lg text-body [&_p]:mb-3 [&_p:last-child]:mb-0" set:html={hero.text} />}
        {hero.image && (
          <div class="mx-auto mt-10 max-w-4xl">
            <img src={hero.image.url} alt={hero.image.alt} loading="eager" width={hero.image.width} height={hero.image.height} class="w-full" />
          </div>
        )}
        {(heroPartnerLogo || (hero.ctaText && hero.ctaUrl)) && (
          <div class="mt-8 flex flex-wrap items-center justify-center gap-6">
            {heroPartnerLogo && (
              <img src={heroPartnerLogo.url} alt={heroPartnerLogo.alt} width={heroPartnerLogo.width} height={heroPartnerLogo.height} loading="eager" />
            )}
            {hero.ctaText && hero.ctaUrl && (
              <a href={hero.ctaUrl} class="btn-cta inline-flex items-center justify-center px-8 py-3 text-sm font-semibold">
                {heroCtaText}
              </a>
            )}
          </div>
        )}
      </section>
    ) : (
      <section id={hero.id} class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
        <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
          <div>
            <h1
              class="text-3xl font-bold leading-tight tracking-tight text-heading sm:text-4xl lg:text-5xl"
              set:html={hero.title}
            />
            {hero.text && <p class="mt-5 max-w-xl text-lg text-body" set:html={hero.text} />}
            {
              hero.ctaText && hero.ctaUrl && (
                <a
                  href={hero.ctaUrl}
                  class="btn-cta mt-8 inline-flex items-center justify-center px-8 py-3 text-sm font-semibold"
                >
                  {heroCtaText}
                </a>
              )
            }
          </div>
          {
            hero.image && (
              <div class="flex items-center justify-center">
                <img
                  src={hero.image.url}
                  alt={hero.image.alt}
                  loading="eager"
                  width={hero.image.width}
                  height={hero.image.height}
                  class="w-full rounded-2xl object-cover"
                />
              </div>
            )
          }
        </div>
      </section>
    )
  }

  <!-- İçerik blokları (veri kaynaklı, sabit sayı değil — sırayla alternatif zeminle) -->
  {
    sections.map((section, i) => {
      // Bölüm-seviyesi CTA override'ı (2026-08-12) — bkz. `sectionCtaOverrides`
      // prop yorumu. Kaynakta o bölümün HİÇ CTA'sı yoksa (`ctaUrl` boş)
      // override'ın kendi `ctaUrl`'i kullanılır (yeni bir CTA EKLENMİŞ olur);
      // zaten bir CTA varsa yalnızca metni değişir, mevcut `ctaUrl` KORUNUR.
      const ctaOverride = sectionCtaOverrides?.[i];
      const effectiveSection = ctaOverride
        ? { ...section, ctaText: ctaOverride.ctaText, ctaUrl: ctaOverride.ctaUrl ?? section.ctaUrl }
        : section;
      // `id === 'platform'` — YALNIZCA `hardwareContent.ts`/`donanim.astro`'nun
      // "Donanım çekirdek platform" bölümü (kaynakta doğrulandı, canlı sitede
      // bu TEK bölüm düz kırmızı `bg-brand` zeminde + beyaz illüstrasyon/metin,
      // diğer hiçbir ürün/hub sayfasında bu id kullanılmıyor — bkz.
      // `ProductSectionBlock.astro`'nun `variant` prop yorumu). Düz `bg-white`
      // zeminde render edilince görselin beyaz çizgi sanatı görünmez oluyordu
      // (2026-08-21, kullanıcı bulgusu).
      const isBrandSection = section.id === 'platform';
      const bgStyle = section.backgroundImage
        ? `background-image:url(${section.backgroundImage});background-position:center;background-repeat:no-repeat;background-size:contain;`
        : undefined;
      return (
        <section
          id={section.id}
          class={`${isBrandSection ? 'bg-brand' : i % 2 === 1 ? 'bg-brand-light' : ''} ${section.backgroundImage ? 'bg-[#EDEDED]' : ''}`}
          style={bgStyle}
        >
          <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
            <ProductSectionBlock
              section={effectiveSection}
              reverse={effectiveSection.reverse ?? i % 2 === 1}
              variant={isBrandSection ? 'brand' : 'default'}
            />
          </div>
        </section>
      );
    })
  }

  <!-- SSS -->
  {
    faq.length > 0 && (
      <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
        <script type="application/ld+json" set:html={safeJsonLd(faqJsonLd)} is:inline />
        <h2 class="h2-section text-heading">{t.mega.urunler.intro.faqLink}</h2>
        <div class="mt-6 divide-y divide-gray-100">
          {faq.map((item) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-heading marker:content-none">
                <h3 class="m-0 text-base font-semibold text-heading">{item.question}</h3>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 12 12"
                  fill="none"
                  aria-hidden="true"
                  class="h-3 w-3 shrink-0 transition-transform group-open:rotate-180"
                >
                  <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <div class="mt-3 text-sm text-body [&_p]:mb-2 [&_p:last-child]:mb-0" set:html={item.answer} />
            </details>
          ))}
        </div>
      </section>
    )
  }

  <!-- "No visible content dates" GEO bulgusu (2026-08-17) — kullanıcı
       kararıyla CTA'nın hemen altından sayfanın EN ALTINA taşındı (dikkat
       çekmeyen, ama gerçek içerik sayfasında hâlâ var olan bir konum). -->
  <div class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
    <LastUpdated date={modified} locale={locale} />
  </div>
</BaseLayout>
