---
// İstatistik şeridi (2026-08-07 güçlendirme). Önceki tur: 3 istatistik,
// düz `bg-brand-light` zemin, yalnızca ISO'da ikon. Bu tur (KONU 3):
// - Zemin bold `bg-brand` (KONU 1 ile aynı ilke — soluk pastelden kaçınma).
// - Her istatistik artık beyaz bir kartın içinde (gölge + ikon).
// - 2 yeni GERÇEK/doğrulanabilir istatistik eklendi: "18 modül" (bkz.
//   CLAUDE.md §Proje Özeti — "18 modül + Puantaj + 2 hub + Demirbaş/
//   Seyahat" — 18 rakamı doğrudan oradan, uydurulmadı) ve "4 dil" (site
//   genelinin desteklediği tr/en/nl/it locale sayısı, `astro.config.mjs`).
// - 4 sayı artık animasyonlu (`landing-stat-counter.js`), yalnızca ISO
//   (bileşik rozet metni, tek sayı değil) sabit kalıyor.
// - Kartların kendisi artık `.reveal` ile staggered scroll-reveal alıyor
//   (önceki turda yalnızca sayı animasyonu vardı, kart girişi yoktu).
import { Users, Clock, LayoutGrid, Globe, ShieldCheck } from 'lucide-react';

const COUNTERS = [
  { icon: Users, target: 1000, suffix: '+', label: 'mutlu müşteri' },
  { icon: Clock, target: 48, suffix: ' saat', label: 'kurulum süresi' },
  { icon: LayoutGrid, target: 18, suffix: '', label: 'modül tek platformda' },
  { icon: Globe, target: 4, suffix: ' dil', label: 'hizmet' },
];

const cardClass = 'reveal flex flex-col items-center rounded-2xl bg-white p-5 text-center shadow-[0_10px_30px_-10px_rgba(0,0,0,0.35)]';
---

<section class="bg-brand py-16 lg:py-20">
  <div class="mx-auto max-w-5xl px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 lg:gap-6">
      {
        COUNTERS.map(({ icon: Icon, target, suffix, label }, i) => (
          <div class={cardClass} style={`transition-delay: ${i * 90}ms`}>
            <Icon className="h-7 w-7 text-brand" aria-hidden="true" />
            <p class="mt-3 text-3xl font-bold text-heading" data-stat-counter data-target={target} data-suffix={suffix}>
              {`0${suffix}`}
            </p>
            <p class="mt-1 text-xs text-muted">{label}</p>
          </div>
        ))
      }
      <div class={cardClass} style={`transition-delay: ${COUNTERS.length * 90}ms`}>
        <ShieldCheck className="h-7 w-7 text-brand" aria-hidden="true" />
        <p class="mt-3 text-lg font-bold text-heading">ISO 27001 · 9001</p>
        <p class="mt-1 text-xs text-muted">sertifikalı</p>
      </div>
    </div>
  </div>
</section>

<script src="../scripts/landing-stat-counter.js"></script>
