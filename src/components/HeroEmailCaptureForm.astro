---
// Ana sayfa hero'sunun YENİ, tek-alanlı (yalnızca e-posta) formu —
// 2026-08-19, kullanıcının referans görüntüsüne dayanan bilinçli yeni bir
// tasarım kararı. Eski çok-alanlı `HeroForm.tsx` (isim/telefon/firma/
// e-posta + KVKK metni) burada ARTIK KULLANILMIYOR — o component hâlâ
// PanelFeatureSection/ContactPage/PresentationRequestPage'de aynen duruyor,
// yalnızca ana sayfanın EN ÜST hero'su bu sade forma geçti.
//
// React GEREKMİYOR: form GET metoduyla doğrudan Online Sunum Talebi
// sayfasına gönderiliyor (`action={demoHref} method="get"`) — tarayıcı
// input'un `name="email"` değerini otomatik olarak `?email=...` query
// string'ine ekliyor, hiçbir JS/state gerekmiyor
// (`FloatingContactButtons.astro`/`StickyDemoBar.astro` ile aynı "gerçek
// etkileşim yoksa React kullanma" ilkesi). Hedef sayfadaki `HeroForm.tsx`
// bu `email` parametresini `prefillEmailFromQuery` prop'uyla okuyup kendi
// e-posta alanını otomatik dolduruyor (bkz. o dosyadaki yorum).
import { getRelativeLocaleUrl } from 'astro:i18n';
import { isGenericCtaText, buildCtaAnchorText } from '../data/pageTitle';
import type { Locale } from '../data/nav';

interface Props {
  locale: Locale;
  placeholder: string;
  /** Ham `t.hero.formSubmit` — jenerikse (`isGenericCtaText()`) eski
   * `HeroForm.tsx`'teki AYNI CTA/anchor-text kuralıyla (2026-08-12)
   * `ctaKeyword`'a dönüştürülüyor, böylece buton metni bu form değişse
   * bile ÖNCEKİYLE BİREBİR aynı kalıyor (ör. TR: "Ücretsiz Demo için
   * Başvur"). */
  submitLabel: string;
  ctaKeyword: string;
}

const { locale, placeholder, submitLabel, ctaKeyword } = Astro.props;
const demoHref = getRelativeLocaleUrl(locale, 'online-sunum-talep-et');
const resolvedSubmitLabel = isGenericCtaText(submitLabel) ? buildCtaAnchorText(ctaKeyword, locale) : submitLabel;
---

<form action={demoHref} method="get" class="flex flex-col gap-3 sm:flex-row sm:items-stretch">
  <label for="hero-email-capture" class="sr-only">{placeholder}</label>
  <input
    id="hero-email-capture"
    name="email"
    type="email"
    required
    placeholder={placeholder}
    class="w-full min-w-0 rounded-full border-2 border-brand bg-white px-6 py-3.5 text-base font-normal text-heading placeholder:text-muted transition-colors focus:outline-none"
  />
  <button type="submit" class="btn-cta shrink-0 whitespace-nowrap px-8 py-3.5">
    {resolvedSubmitLabel}
  </button>
</form>
