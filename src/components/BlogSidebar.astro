---
// idenfit.com/blog/'un gerçek sağ sidebar'ı (canlı HTML'i incelenerek
// birebir çıkarıldı, 2026-07-24) — "Popüler İçerikler" (aslında en son 5
// yazı, gerçek popülerlik verisi yok) + "Yaklaşan Etkinlikler" (`yaklasan-
// etkinlikler` kategorisindeki tüm yazılar). Hem blog listesi hem tekil
// yazı sayfasında aynı (bkz. `BlogListPage.astro`, `src/pages/blog/[slug].astro`).
import { formatBlogDate, getPopularPosts, getUpcomingEventPosts, type BlogPost } from '../data/blogContent';

interface Props {
  allPosts: BlogPost[];
}

const { allPosts } = Astro.props;
const popularPosts = getPopularPosts(allPosts);
const upcomingEventPosts = getUpcomingEventPosts(allPosts);
---

<aside class="flex flex-col gap-10 lg:w-[300px] lg:shrink-0">
  {
    popularPosts.length > 0 && (
      <div>
        <h2 class="text-lg font-bold text-heading">Popüler İçerikler</h2>
        <ul class="mt-4 flex flex-col gap-3">
          {popularPosts.map((post) => (
            <li>
              <a href={`/blog/${post.data.slug}/`} class="group flex items-start gap-3">
                {post.data.featuredImage && (
                  <span class="block h-10 w-10 shrink-0 overflow-hidden rounded">
                    <img
                      src={post.data.featuredImage.url}
                      alt={post.data.featuredImage.alt}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
                    />
                  </span>
                )}
                <span class="flex flex-col">
                  <span class="text-sm font-semibold leading-snug text-heading transition-colors group-hover:text-brand">
                    {post.data.title}
                  </span>
                  <time datetime={post.data.date.toISOString()} class="mt-1 text-xs text-muted">
                    {formatBlogDate(post.data.date)}
                  </time>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    upcomingEventPosts.length > 0 && (
      <div>
        <h2 class="text-lg font-bold text-heading">Yaklaşan Etkinlikler</h2>
        <ul class="mt-4 flex flex-col gap-3">
          {upcomingEventPosts.map((post) => (
            <li>
              <a href={`/blog/${post.data.slug}/`} class="group flex items-start gap-3">
                {post.data.featuredImage && (
                  <span class="block h-10 w-10 shrink-0 overflow-hidden rounded">
                    <img
                      src={post.data.featuredImage.url}
                      alt={post.data.featuredImage.alt}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
                    />
                  </span>
                )}
                <span class="flex flex-col">
                  <span class="text-sm font-semibold leading-snug text-heading transition-colors group-hover:text-brand">
                    {post.data.title}
                  </span>
                  <time datetime={post.data.date.toISOString()} class="mt-1 text-xs text-muted">
                    {formatBlogDate(post.data.date)}
                  </time>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</aside>
