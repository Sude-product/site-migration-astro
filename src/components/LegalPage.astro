---
// Basit hukuki/metin sayfaları (Tüketici Hakları Sözleşmesi, Mesafeli
// Satış Sözleşmesi) — tek başlık + tam bir `content_block` HTML alanı.
// ProductPage.astro'ya zorla uydurulmadı (hero/section/FAQ şeması yok,
// gerçekten düz bir metin sayfası).
import BaseLayout from '../layouts/BaseLayout.astro';
import LastUpdated from './LastUpdated.astro';
import { buildIdenfitTitle } from '../data/pageTitle';
import { structureLegalHeadings } from '../data/legalHeadingSanitizer';
import type { LegalContent } from '../data/miscPagesContent';
import type { Locale } from '../data/nav';

interface Props {
  content: LegalContent;
  localeUrls: Record<string, string | undefined>;
  /** hreflang için GERÇEK içeriği olan locale listesi — bkz.
   * `BaseLayout.astro`'daki `hreflangLocales` prop yorumu. Bu component 5
   * farklı hukuki aile tarafından paylaşıldığı için (KVKK/KVK Protokol/
   * Tüketici Hakları/Mesafeli Satış/Gizlilik ve Güvenlik Politikası) hangi
   * dillerin gerçek olduğunu KENDİSİ bilemez — çağıran sayfa geçirmeli. */
  hreflangLocales?: Locale[];
  /** Meta description override (2026-08-10, meta description uzunluk
   * denetimi — bkz. CLAUDE.md). Varsayılan davranış (`content.contentHtml`'in
   * ilk 160 karakteri) KÖK NEDEN BUG'IYDI: hukuki belgeler genelde şirket
   * ünvanı/adresiyle BAŞLADIĞI için ("Ünvanı : Idenfit Bilişim Hizmetleri
   * Sanayi ve Dış Ticaret A.Ş. Adresi : ...") çıkan description bir özet
   * değil, ham adres bloğuydu — 8 sayfanın TAMAMINDA (14 dil varyantı)
   * aynı desen. Artık HER sayfa gerçek, elle yazılmış bir açıklama
   * geçiriyor; verilmezse eski (kusurlu) davranışa düşer — geriye dönük
   * uyumluluk için, yeni bir legal sayfa eklenip description unutulursa
   * sessizce boş kalmasın diye. */
  description?: string;
  /** "No visible content dates" GEO bulgusu (2026-08-17) — bkz.
   * `LastUpdated.astro`. */
  modified?: Date;
}

const { content, localeUrls, hreflangLocales, description: descriptionOverride, modified } = Astro.props;
const locale = (Astro.currentLocale ?? 'tr') as Locale;
// H2/H3 alt başlığı eksikliği düzeltmesi (2026-08-13) — bkz.
// `legalHeadingSanitizer.ts`'in dosya başı yorumu (kök neden + 3 dönüşüm
// kuralı). Zaten sağlıklı sayfalarda (KVKK TR, KVK Protokol) no-op.
const structuredHtml = structureLegalHeadings(content.contentHtml, content.title);
const description = descriptionOverride ?? structuredHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 160);
// `content.title` bazı hukuki sayfalarda 50 karakterin altında (2026-08-10
// title uzunluk denetimi) — bkz. `buildIdenfitTitle()`.
const title = buildIdenfitTitle(content.title, locale);
---

<BaseLayout
  title={title}
  description={description}
  localeUrls={localeUrls}
  hreflangLocales={hreflangLocales}
  dateModified={modified?.toISOString()}
>
  <div class="w-full px-4 py-12 sm:px-6 lg:px-[100px] lg:py-16">
    <section class="mx-auto max-w-[1440px]">
      <h1 class="text-4xl font-normal uppercase leading-[43px] text-brand">{content.title}</h1>
      <div
        class="prose-legal mt-10 text-base leading-[30px] text-black [&_a]:text-brand [&_h1]:mt-6 [&_h1]:text-2xl [&_h1]:font-medium [&_h1]:leading-[28px] [&_h1]:text-brand [&_h2]:mt-6 [&_h2]:text-2xl [&_h2]:font-medium [&_h2]:leading-[28px] [&_h2]:text-brand [&_h3]:mt-6 [&_h3]:text-2xl [&_h3]:font-medium [&_h3]:leading-[28px] [&_h3]:text-brand [&_h4]:mt-6 [&_h4]:text-2xl [&_h4]:font-medium [&_h4]:leading-[28px] [&_h4]:text-brand [&_li]:mb-0 [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-10 [&_p]:mb-4 [&_strong]:font-bold [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-10 [&_table]:w-full [&_table]:border-collapse [&_th]:border [&_th]:border-[#dee2e6] [&_th]:p-2 [&_th]:text-left [&_th]:font-bold [&_td]:border [&_td]:border-[#dee2e6] [&_td]:p-2 [&_td]:font-normal [&_tbody_tr:nth-of-type(odd)]:bg-black/5"
        set:html={structuredHtml}
      />
      <!-- "No visible content dates" GEO bulgusu (2026-08-17) — kullanıcı
           kararıyla H1'in hemen altından sayfanın EN ALTINA taşındı. -->
      <div class="mt-10">
        <LastUpdated date={modified} locale={locale} />
      </div>
    </section>
  </div>
</BaseLayout>
