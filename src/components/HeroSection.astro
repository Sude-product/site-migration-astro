---
import HeroEmailCaptureForm from './HeroEmailCaptureForm.astro';
import ProductPreviewWidget from './ProductPreviewWidget.tsx';
import { getTranslations } from '../i18n';
import { getSupportRequestLocaleUrls } from '../data/supportRequestContent';
import type { Locale } from '../data/nav';

const locale = (Astro.currentLocale ?? 'tr') as Locale;
const t = getTranslations(locale);
// KVKK/Kullanım Koşulları onay metni (eski çok-alanlı `HeroForm`'un
// `kvkkNotice` bloğu) — 2026-08-19'da form tek e-posta alanına
// indirgenince artık burada RENDER EDİLMİYOR (yeni `HeroEmailCaptureForm`
// bu metni hiç taşımıyor, `getKvkkAndTermsHrefs()` de bu yüzden artık
// kullanılmıyor) — KVKK onay metni hâlâ hedef sayfada (Online Sunum
// Talebi'nin KENDİ formunda) mevcut, veri orada toplanıyor.
// "Destek Talebi İçin Tıklayın" — kaynakta (idenfit.com'un anasayfası/
// footer'ı) BULUNAMADI (2026-07-27'de canlı HTML'de arandı, hiç yok) —
// kullanıcı isteğiyle yeni eklenen bir giriş noktası, kırık bir linki
// düzeltme DEĞİL (bkz. CLAUDE.md).
const supportRequestHref = getSupportRequestLocaleUrls()[locale];

// ⚠️ DÜZELTME (2026-07-28, BEŞİNCİ tur): dördüncü turda "gereksiz tekrar"
// gerekçesiyle bu ikonlar buradan KALDIRILIP yalnızca site-geneli
// `FloatingContactButtons.astro`'ya bırakılmıştı — bu KASITLI bir
// konsolidasyon kararıydı (CSS regresyonu/üzerine yazılma DEĞİL), ama
// kullanıcı Destek Talebi linkinin altında da AYRICA görünmesini istediği
// için geri eklendi. Artık HEM site-geneli sabit widget (sağ-alt, her
// sayfada) HEM bu satır-içi çift (yalnızca ana sayfanın hero'sunda) aynı
// anda var — kasıtlı, kod tekrarı değil (ikisi farklı boyut/bağlamda).
// Stil `FloatingContactButtons.astro` ile TUTARLI: WhatsApp beyaz zemin +
// kırmızı ikon/kenarlık, Ara dolu kırmızı zemin + beyaz ikon — yeşil YOK.
const WHATSAPP_URL = 'https://wa.me/905375265307';
const CALL_URL = 'tel:02162950927';
---

<!-- 2026-08-19 (SEKİZİNCİ tur) — kullanıcı iki-kolonlu (sol metin/sağ
     kırmızı görsel paneli) düzeni terk edip TEK KOLON istedi: metin/form
     ortalanıp üstte, "dashboard" bölümü aralarında boşluk bırakılarak
     ALTA taşındı. Önceki `grid-cols-2`/full-bleed sağ panel mimarisi
     (birden fazla turun konusu olmuştu) bu yüzden TAMAMEN kaldırıldı —
     artık `<section>` doğrudan iki dikey blok içeriyor: üstte ortalanmış
     metin/form, altında (aralarında boşluk) dashboard bölümü. DOKUZUNCU
     turda bu alt blok statik görselden GERÇEK/canlı
     `ProductPreviewWidget`'a çevrildi (önce yalnızca TR'de, ON BİRİNCİ
     turda — aşağıda — 4 dilin hepsine genişletildi). -->
<!-- Arka plan alt-tonu (2026-08-24, kullanıcı isteği: "Personio web
     sayfası tasarımına benzer" — dashboard widget'ının HEMEN ALTINDA
     başlayan yumuşak bir renk parıltısının, metin/form bölümüne doğru
     yukarı sızması). Düz `#F8F8F8` yerine, widget çerçevesinin KENDİ
     gradyanıyla (`#FFDCDC→#FFF3F3→#FFFFFF`, hemen aşağıda) AYNI kırmızı
     tonu ailesinden radyal bir geçiş — yeni bir renk İCAT EDİLMEDİ,
     sitenin zaten kullandığı ton yeniden kullanıldı. Merkez alt-ortada
     (widget'a en yakın nokta) en yoğun, yukarı doğru beyaza sönümleniyor. -->
<section class="py-12 lg:py-20" style="background: radial-gradient(120% 90% at 50% 100%, #FFDCDC 0%, #FFF3F3 40%, #FFFFFF 75%);">
	<div class="mx-auto flex w-full max-w-2xl flex-col items-center px-4 text-center sm:px-6 lg:px-8">
		<!-- 2026-07-28 (üçüncü tur): boyut/renk kaynaktan BİREBİR okundu
		     (`post-25148.css`, `.elementor-element-0c8eb2b`/`4ec6dae`) —
		     H1 mobilde 20px, `lg:` 35px/`font-weight:600`/`line-height:45px`
		     (kaynağın kendi custom CSS'i, `!important`); paragraf mobilde
		     16px, `lg:` 20px, renk TAM OLARAK `#808080` = bizim `--color-muted`
		     token'ımızla birebir aynı. Boşluklar (`mt-[15px]`) kaynağın
		     `padding:15px 0px` kuralından BİREBİR. -->
		<h1 class="whitespace-pre-line text-xl font-semibold leading-tight tracking-tight text-heading lg:text-[35px] lg:leading-[45px]">
			{t.hero.headline}
		</h1>
		<p class="mt-[15px] max-w-xl text-base text-muted lg:text-xl">
			{t.hero.subheadline}
		</p>

		<div class="mt-[15px] flex w-full max-w-md flex-col items-center">
			<HeroEmailCaptureForm
				locale={locale}
				placeholder={t.hero.emailPlaceholder}
				submitLabel={t.hero.formSubmit}
				ctaKeyword={t.hero.ctaKeyword}
			/>
			{
				supportRequestHref && (
					<a
						href={supportRequestHref}
						class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand hover:underline"
					>
						{t.hero.supportRequestLink}
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M5 12h14M13 6l6 6-6 6" />
						</svg>
					</a>
				)
			}
			<div class="mt-2 flex items-center gap-2">
				<a
					href={CALL_URL}
					aria-label={t.hero.callLabel}
					class="flex h-12 w-12 items-center justify-center rounded-full bg-brand text-white shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg motion-reduce:hover:translate-y-0"
				>
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
					</svg>
				</a>
				<a
					href={WHATSAPP_URL}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={t.hero.whatsappLabel}
					class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-brand bg-white text-brand shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:bg-brand hover:text-white hover:shadow-lg motion-reduce:hover:translate-y-0"
				>
					<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347z" />
						<path d="M12.001 2c-5.522 0-10 4.477-10 10 0 1.75.457 3.443 1.325 4.938L2 22l5.213-1.31A9.933 9.933 0 0 0 12.001 22c5.522 0 10-4.477 10-10s-4.478-10-10-10zm0 18.153a8.14 8.14 0 0 1-4.146-1.137l-.297-.177-3.096.777.827-3.02-.194-.31a8.129 8.129 0 0 1-1.245-4.336c0-4.495 3.657-8.153 8.154-8.153 4.495 0 8.152 3.658 8.152 8.153 0 4.496-3.657 8.153-8.152 8.153h-.003z" />
					</svg>
				</a>
			</div>
		</div>
	</div>

	<!-- 2026-08-19 (ON BİRİNCİ tur) — kullanıcı "diğer dillerde canlı
	     dashboard görünmüyor, düzelt" dedi: DOKUZUNCU turdaki `locale ===
	     'tr'` koşulu (widget'ı yalnızca TR'ye sınırlayan, statik görseli
	     EN/NL/IT'ye bırakan dal) TAMAMEN kaldırıldı — artık widget 4 dilde
	     de aynı şekilde render ediliyor. Widget'ın kendi içeriği hâlâ
	     Türkçe (kurgusal veri/etiketler, bkz. CLAUDE.md §Açık noktalar —
	     i18n kapsamı onayı) ama bu artık BİLİNÇLİ bir kullanıcı kararı,
	     ertelenmiş bir eksiklik değil. Statik `HOME_HERO_IMAGE`/
	     `heroImage`/`sideTitle`/`sideSubtitle` dalı ARTIK KULLANILMIYOR,
	     kaldırıldı (import da temizlendi) — i18n şemasındaki
	     `sideTitle`/`sideSubtitle` alanları başka hiçbir yerde
	     kullanılmadığı için dokunulmadan bırakıldı (şema değişikliği bu
	     turun kapsamı DIŞINDA). Çerçeve/gradyan/sahte tarayıcı bar'ı
	     (2026-08-20'de kaldırılan) `HomeProductPreview.astro`'nun aynısıydı
	     (ikinci bir görsel dil İCAT EDİLMEDİ) — o component artık sayfada
	     YOK (widget iki kez gösteriliyordu, hero'daki bu YETERLİ görüldüğü
	     için alttaki kaldırıldı, bkz. CLAUDE.md Açık nokta #35). Genişlik/
	     yükseklik ayarları (ONUNCU tur) aynen korundu. -->
	<div class="mx-auto mt-8 w-full max-w-[88rem] px-4 sm:px-6 lg:mt-10 lg:px-8">
		<div
			class="rounded-[2rem] p-3 ring-1 ring-white/50 sm:p-5 lg:p-6"
			style="background: linear-gradient(to bottom, #FFDCDC 0%, #FFF3F3 22%, #FFFFFF 50%, #FFF3F3 78%, #FFDCDC 100%);"
		>
			<div class="reveal overflow-hidden rounded-2xl shadow-[0_14px_50px_rgba(138,0,0,0.16)] ring-1 ring-white/70">
				<div class="flex items-center gap-3 border-b border-gray-200 bg-white px-4 py-3 sm:px-6">
					<div class="flex gap-1.5" aria-hidden="true">
						<span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
						<span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
						<span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
					</div>
					<span class="flex-1 truncate rounded-md bg-gray-100 px-3 py-1 text-center text-xs text-muted">app.idenfit.com</span>
				</div>
				<ProductPreviewWidget client:visible />
			</div>
		</div>
	</div>
</section>
