---
// Öne çıkan özellikler — bento grid (2026-08-07). 6 kutu, gerçek platform
// modüllerinin özetleri (kullanıcı tarafından verildi). 3'lü grid'de
// span-2/span-1 dönüşümlü yerleşim (her satır tam dolduruyor, boş hücre
// kalmıyor) — "farklı boyutlarda" isteğiyle tutarlı gerçek bir bento hissi.
// İkonlar yalnızca dekoratif, `client:*` OLMADAN server-only render
// ediliyor (JS gönderilmiyor) — hover büyüme efekti saf CSS
// (`transition-transform`), etkileşim gerektirmiyor.
//
// 2026-08-07 güçlendirme (KONU 1 + 5): ikon rozeti soluk `bg-brand-light`
// yerine dolu `bg-brand` + beyaz ikon (daha cesur/doygun kırmızı, pastel
// tondan kaçınma) — kutular artık `.reveal` ile staggered scroll-reveal
// alıyor (önceden hiç yoktu).
import { UserCog, CalendarClock, Workflow, FileLock2, Target, Table2, type LucideIcon } from 'lucide-react';

interface BentoItem {
  icon: LucideIcon;
  title: string;
  text: string;
  wide?: boolean;
}

const ITEMS: BentoItem[] = [
  {
    icon: UserCog,
    title: 'Bütüncül İK Yönetimi',
    text: 'Özlük bilgileri tek merkezden, onboarding/offboarding görev bazlı takip edilir.',
    wide: true,
  },
  {
    icon: CalendarClock,
    title: 'Zaman, Vardiya ve Puantaj',
    text: 'Canlı monitörle giriş-çıkış takibi, mobil üzerinden eksik kayıt tamamlama.',
  },
  {
    icon: Workflow,
    title: 'Onay ve Talep Akışları',
    text: 'İzin, harcama, avans, fazla mesai, seyahat — hiyerarşik onay mekanizmalarıyla.',
  },
  {
    icon: FileLock2,
    title: 'Bordro ve Doküman Yönetimi',
    text: 'Şifreli mobil erişim, özlük evrakları güvenle depolanır.',
    wide: true,
  },
  {
    icon: Target,
    title: 'Performans, Eğitim, İletişim',
    text: '360 derece değerlendirme, eğitim planlama, anonim geri bildirim.',
    wide: true,
  },
  {
    icon: Table2,
    title: 'Toplu İşlem Esnekliği',
    text: 'Excel ile toplu veri aktarımı, tek tıkla yüzlerce çalışana rol/vardiya/izin atama.',
  },
];
---

<section class="bg-surface py-16 lg:py-24">
  <div class="mx-auto max-w-5xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="h2-section text-heading">Öne Çıkan Özellikler</h2>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        ITEMS.map(({ icon: Icon, title, text, wide }, i) => (
          <div
            class:list={[
              'reveal group rounded-xl bg-white p-6 shadow-[0_4px_34px_rgba(0,0,0,0.07)] transition-transform duration-200 hover:scale-[1.02]',
              wide && 'lg:col-span-2',
            ]}
            style={`transition-delay: ${Math.min(i, 5) * 80}ms`}
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-brand">
              <Icon className="h-6 w-6 text-white" aria-hidden="true" />
            </div>
            <h3 class="mt-4 text-lg font-semibold text-heading">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-body">{text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
