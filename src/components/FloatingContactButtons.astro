---
// Sağ-altta sabit duran WhatsApp/Ara butonları — idenfit.com'un HER
// sayfasında (`.whatsapp-button`/`.call-button`, `position:fixed;
// right:20px`, WhatsApp `bottom:20px`/Ara `bottom:75px`, canlı HTML'de
// doğrulandı) görünen gerçek widget. 2026-07-28'e kadar yalnızca ana
// sayfanın hero'sunun altına (küçük, satır-içi ikonlar olarak, bkz.
// `HeroSection.astro`) eklenmişti — bu turda kullanıcı isteğiyle SİTE
// GENELİNE (`BaseLayout.astro`, TÜM sayfaların tek ortak layout'u —
// proje genelinde `Layout.astro` kullanılmıyor, yalnızca `BaseLayout.astro`
// gerçek sayfalarca import ediliyor) taşındı. Renk: marka kırmızısı/beyaz
// (kaynağın WhatsApp'a kendi yeşilini vermesinden BİLİNÇLİ sapma —
// kullanıcı kararı, bkz. CLAUDE.md "WhatsApp ikonu" günlüğü).
import { getTranslations } from '../i18n';
import type { Locale } from '../data/nav';

const locale = (Astro.currentLocale ?? 'tr') as Locale;
const t = getTranslations(locale);

const WHATSAPP_URL = 'https://wa.me/905375265307';
const CALL_URL = 'tel:02162950927';
---

<div class="fixed bottom-5 right-5 z-50 flex flex-col items-end gap-3" aria-hidden="false">
	<a
		href={CALL_URL}
		aria-label={t.hero.callLabel}
		class="flex h-14 w-14 items-center justify-center rounded-full bg-brand text-white shadow-lg transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl motion-reduce:hover:translate-y-0"
	>
		<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
		</svg>
	</a>
	<a
		href={WHATSAPP_URL}
		target="_blank"
		rel="noopener noreferrer"
		aria-label={t.hero.whatsappLabel}
		class="flex h-14 w-14 items-center justify-center rounded-full border-2 border-brand bg-white text-brand shadow-lg transition-all duration-200 hover:-translate-y-0.5 hover:bg-brand hover:text-white hover:shadow-xl motion-reduce:hover:translate-y-0"
	>
		<svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347z" />
			<path d="M12.001 2c-5.522 0-10 4.477-10 10 0 1.75.457 3.443 1.325 4.938L2 22l5.213-1.31A9.933 9.933 0 0 0 12.001 22c5.522 0 10-4.477 10-10s-4.478-10-10-10zm0 18.153a8.14 8.14 0 0 1-4.146-1.137l-.297-.177-3.096.777.827-3.02-.194-.31a8.129 8.129 0 0 1-1.245-4.336c0-4.495 3.657-8.153 8.154-8.153 4.495 0 8.152 3.658 8.152 8.153 0 4.496-3.657 8.153-8.152 8.153h-.003z" />
		</svg>
	</a>
</div>
