---
import type { ProductBlock } from '../data/productContent';

interface Props {
  section: ProductBlock;
  reverse?: boolean;
  /** `'brand'` — düz kırmızı (`bg-brand`) zemin üzerine BEYAZ ikon/illüstrasyon
   * grafiği için (bkz. `donanim.astro`'nun `id: 'platform'` bölümü, kaynakta
   * TÜM bölüm — görsel + metin — kırmızı zeminde, görsel şeffaf/beyaz çizgi
   * sanatı, düz sayfa zemininde beyaz-üstüne-beyaz görünmez oluyordu). Görsel
   * için `rounded-2xl` KALDIRILIYOR (kaynakta kart/foto değil, zemine
   * karışan bir illüstrasyon — köşe yuvarlama yanlış bir "kart" izlenimi
   * verir), başlık/metin beyaza dönüyor. Verilmezse (varsayılan) davranış
   * DEĞİŞMEDİ. */
  variant?: 'default' | 'brand';
}

const { section, reverse = false, variant = 'default' } = Astro.props;
const { title, text, ctaText, ctaUrl, image, images } = section;
const onBrand = variant === 'brand';
const hasVisual = Boolean(image || (images && images.length > 0));
---

<div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
  {
    images && images.length > 0 ? (
      <div class={reverse ? 'lg:order-2' : 'lg:order-1'}>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
          {images.map((img) => (
            <div class="flex aspect-square items-center justify-center rounded-xl bg-white p-4 shadow-sm">
              <img src={img.url} alt={img.alt} loading="lazy" width={img.width} height={img.height} class="h-full w-full object-contain" />
            </div>
          ))}
        </div>
      </div>
    ) : (
      image && (
        <div class={reverse ? 'lg:order-2' : 'lg:order-1'}>
          <img
            src={image.url}
            alt={image.alt}
            loading="lazy"
            width={image.width}
            height={image.height}
            class={onBrand ? 'w-full object-contain' : 'w-full rounded-2xl object-cover'}
          />
        </div>
      )
    )
  }
  <div class={hasVisual ? (reverse ? 'lg:order-1' : 'lg:order-2') : ''}>
    <h2 class:list={['h2-section', onBrand ? 'text-white' : 'text-heading']} set:html={title} />
    {
      text && (
        <div
          class:list={[
            'mt-4 [&_li]:mb-1 [&_p]:mb-3 [&_p:last-child]:mb-0 [&_ul]:list-disc [&_ul]:pl-5',
            onBrand
              ? 'text-white/90 [&_strong]:font-semibold [&_strong]:text-white'
              : 'text-body [&_strong]:font-semibold [&_strong]:text-heading',
          ]}
          set:html={text}
        />
      )
    }
    {
      ctaText && ctaUrl && (
        <a href={ctaUrl} class="btn-cta mt-4 inline-flex items-center justify-center px-6 py-2.5 text-sm font-semibold">
          {ctaText}
        </a>
      )
    }
  </div>
</div>
