---
// Destek Talebi (`/destek-talebi/`) — ortada beyaz, yuvarlak köşeli (30px)
// bir kart içinde form. Formun altında (kartın DIŞINDA, sayfanın beyaz
// zemininde) "SSS'yi ziyaret et" bloğu var — bkz. `supportRequestContent.ts`.
//
// 2026-09-02 (kullanıcı isteği) — hero zemini kaynağın düz kırmızısından
// (`bg-brand`, 2026-07-27'de Playwright ile ölçülmüştü) Online Sunum
// Talebi sayfasıyla (`PresentationRequestPage.astro`) AYNI radyal
// pembe→beyaz gradyana çevrildi — bilinçli bir marka tutarlılığı kararı,
// kaynak sadakati DEĞİL. `heroBackground` de AYNI nedenle (breadcrumb'ın
// alt kenarıyla hero'nun üst kenarı arasında "dikiş" oluşmasın diye)
// eklendi — `PresentationRequestPage.astro`'daki AYNI desen.
import BaseLayout from '../layouts/BaseLayout.astro';
import SupportRequestForm from './SupportRequestForm.tsx';
import LastUpdated from './LastUpdated.astro';
import IdenfitStar from './icons/IdenfitStar';
import { getKvkkAndTermsHrefs } from '../data/miscPagesContent';
import {
  getSupportFaqHref,
  getSupportRequestLocaleUrls,
  getSupportRequestModifiedDate,
  type SupportRequestContent,
} from '../data/supportRequestContent';
import { getSupportThankYouLocaleUrls } from '../data/supportThankYouContent';
import { buildIdenfitTitle } from '../data/pageTitle';
import { getTranslations } from '../i18n';
import type { Locale } from '../data/nav';

interface Props {
  content: SupportRequestContent;
}

const { content } = Astro.props;
const locale = (Astro.currentLocale ?? 'tr') as Locale;
const t = getTranslations(locale);
const { kvkkHref, termsHref } = getKvkkAndTermsHrefs(locale);
const faqHref = getSupportFaqHref(locale);
const title = buildIdenfitTitle(content.pageTitle, locale);
// Form backend'i (2026-09-02, Açık nokta #2) — gerçek gönderim
// başarılı olunca yönlendirilecek, zaten VAR olan (ama hiç bağlanmamış)
// Destek Talebi Teşekkürler sayfası. `SupportThankYouPage.astro`nun
// `getPresentationModifiedDate` benzeri fallback ilkesiyle AYNI (`tr`'ye düş).
const supportThankYouUrls = getSupportThankYouLocaleUrls();
const supportThankYouHref = supportThankYouUrls[locale] ?? supportThankYouUrls.tr ?? '/tesekkurler-destek/';
// ⚠️ BULUNAN BUG (2026-08-17, hreflang turu) — bu component `localeUrls`'i
// HİÇ BaseLayout'a geçirmiyordu, Header'ın dil değiştiricisi bu sayfada
// generic (yanlış, "aynı slug" varsayan) fallback'e düşüyordu — oysa
// `getSupportRequestLocaleUrls()` (doğru per-locale slug'ları döndüren
// fonksiyon) zaten `HeroSection.astro`'da kullanılıyordu, buraya hiç
// bağlanmamıştı. Düzeltildi. NL'de kaynak sayfa yok (aynı fonksiyon NL'i
// EN'e alias'lıyor) — hreflang bu yüzden yalnızca gerçek 3 dili bildiriyor.
const localeUrls = getSupportRequestLocaleUrls();
// "No visible content dates" GEO bulgusu (2026-08-17) — bkz. `LastUpdated.astro`.
const modified = getSupportRequestModifiedDate(locale);
---

<BaseLayout
	title={title}
	description={content.description.replace(/\n/g, ' ')}
	localeUrls={localeUrls}
	hreflangLocales={['tr', 'en', 'it']}
	dateModified={modified?.toISOString()}
	breadcrumb={[{ label: content.pageTitle }]}
	heroBackground="#FFDCDC"
>
	<section
		class="relative overflow-hidden px-4 py-16 sm:px-6 lg:py-24"
		style="background: radial-gradient(120% 90% at 50% 0%, #FFDCDC 0%, #FFF3F3 42%, #FFFFFF 78%);"
	>
		{/* Dekoratif yıldızlar (2026-09-02, kullanıcı isteği) — Online Sunum
		    Talebi hero'sundaki AYNI desen (`IdenfitStar`, form kartının
		    ARKASINDA/`z-0` altı, çok soluk). */}
		<IdenfitStar className="pointer-events-none absolute left-[6%] top-10 h-20 w-20 -rotate-12 text-brand opacity-[0.08] lg:h-28 lg:w-28" />
		<IdenfitStar className="pointer-events-none absolute right-[8%] top-24 hidden h-12 w-12 rotate-45 text-brand opacity-[0.09] sm:block" />
		<IdenfitStar className="pointer-events-none absolute bottom-10 left-[12%] hidden h-14 w-14 rotate-12 text-brand opacity-[0.07] lg:block" />
		<IdenfitStar className="pointer-events-none absolute bottom-16 right-[10%] h-10 w-10 -rotate-45 text-brand opacity-[0.08]" />

		<div class="relative z-10 mx-auto max-w-3xl rounded-[30px] bg-surface p-8 shadow-[4px_8px_40px_0_rgba(0,0,0,0.2)] sm:p-12">
			<h1 class="text-center text-3xl font-bold text-brand sm:text-4xl">{content.pageTitle}</h1>
			<p class="mx-auto mt-4 max-w-xl whitespace-pre-line text-center text-sm leading-relaxed text-body">
				{content.description}
			</p>

			<div class="mt-8">
				<SupportRequestForm
					client:load
					labels={{ ...content.formLabels, kvkkNotice: content.kvkkNotice }}
					locale={locale}
					kvkkHref={kvkkHref}
					termsHref={termsHref}
					redirectHref={supportThankYouHref}
					common={t.common}
				/>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-3xl px-4 py-12 text-center sm:px-6">
		<p class="whitespace-pre-line text-sm leading-relaxed text-body">{content.afterFormText}</p>
		<a href={faqHref} class="mt-4 inline-block text-base font-semibold text-brand hover:underline">
			{content.faqButtonText}
		</a>
		<!-- "No visible content dates" GEO bulgusu (2026-08-17) — kullanıcı
		     kararıyla açıklamanın hemen altından sayfanın EN ALTINA taşındı. -->
		<div class="mt-8">
			<LastUpdated date={modified} locale={locale} />
		</div>
	</section>
</BaseLayout>
