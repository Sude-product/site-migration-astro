---
// "Öne Çıkan Özellikler" — Online Sunum Talebi sayfası için (2026-08-29)
// `/demo` (Landing Page) sayfasındaki `LandingBentoGrid.astro`'nun İÇERİĞİ
// (6 kutu, kullanıcının paylaştığı ekran görüntüsüyle birebir aynı metin —
// yeni bir iddia YAZILMADI) bu sayfaya özel, daha zarif bir tasarımla
// entegre edildi: ikon rozetine gradyan + her kartın köşesine idenfit'in
// gerçek logo yıldızı (`IdenfitStar`, Müşteri Hikayeleri carousel'indeki
// AYNI `idenfit-star-spin` dönen-yıldız deseni — yeni bir animasyon İCAT
// EDİLMEDİ, zaten onaylı deseni yeniden kullanıyor).
import { UserCog, CalendarClock, Workflow, FileLock2, Target, Table2, type LucideIcon } from 'lucide-react';
import IdenfitStar from './icons/IdenfitStar';
import { getTranslations } from '../i18n';
import type { Locale } from '../data/nav';

// 2026-09-02 (kullanıcı bulgusu — "panelden sonraki yerlerde çeviri
// olmuyor") — bu component ÖNCEDEN tamamen hardcoded Türkçe idi. Metin
// artık `t.hero.presentationFeatures`'dan geliyor (5 dilde gerçek çeviri,
// KARAR 1) — İKON'lar ve `wide` (geniş kart) bayrağı burada sabit kalıyor,
// `items` dizisiyle 0-tabanlı INDEX'e göre eşleşiyor.
const locale = (Astro.currentLocale ?? 'tr') as Locale;
const t = getTranslations(locale);
const { presentationFeatures } = t.hero;

const ICONS: LucideIcon[] = [UserCog, CalendarClock, Workflow, FileLock2, Target, Table2];
const WIDE = [true, false, false, true, true, false];
---

<section class="relative bg-[#FAFAFA] py-16 lg:py-24">
  {/* `PresentationTimeline.astro`'daki AYNI dağınık/karışık yıldız dokusu
      ilkesi (2026-08-29) — bu bölümde zaten kartların köşelerinde dönen
      küçük yıldızlar var, o yüzden burada yalnızca 2 tane, daha soluk. */}
  <IdenfitStar className="pointer-events-none absolute -right-10 top-10 h-40 w-40 rotate-[15deg] text-brand opacity-[0.05] lg:h-56 lg:w-56" />
  <IdenfitStar className="pointer-events-none absolute bottom-10 left-[8%] hidden h-16 w-16 -rotate-12 text-brand opacity-[0.07] sm:block" />

  <div class="relative mx-auto max-w-5xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="reveal h2-section text-heading">{presentationFeatures.title}</h2>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        presentationFeatures.items.map(({ title, text }, i) => (
          <div
            class:list={[
              'reveal group relative rounded-2xl border border-[#F0E4E4] bg-white p-6 shadow-[0_10px_34px_-14px_rgba(120,0,0,0.14)] transition-transform duration-200 hover:-translate-y-1',
              WIDE[i] && 'lg:col-span-2',
            ]}
            style={`transition-delay: ${Math.min(i, 5) * 80}ms`}
          >
            <span class="idenfit-star-spin pointer-events-none absolute right-5 top-5 text-brand/70" aria-hidden="true">
              <IdenfitStar className="h-5 w-5" />
            </span>
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-brand to-[#C40000] shadow-[0_8px_18px_-6px_rgba(255,0,0,0.5)]">
              {(() => {
                const Icon = ICONS[i];
                return <Icon className="h-6 w-6 text-white" aria-hidden="true" />;
              })()}
            </div>
            <h3 class="mt-4 text-lg font-semibold text-heading">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-body">{text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
