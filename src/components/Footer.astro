---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getTranslations } from '../i18n';
import { getFaqSlug } from '../data/faqContent';
import {
  getContactSlug,
  getSecuritySlug,
  getPrivacySecuritySlug,
  getGlobalBrandSlug,
  getWhyIdenfitSlug,
  getLegalSlug,
  getAboutSlug,
  getKvkkSlug,
  CONSUMER_RIGHTS_TR_SLUG,
  DISTANCE_SALES_TR_SLUG,
} from '../data/miscPagesContent';
import { getPricingSlug } from '../data/pricingContent';
import { getProductSlug } from '../data/productContent';
import { getHardwareSlug } from '../data/hardwareContent';
import IdenfitLogo from './icons/IdenfitLogo.tsx';
import type { Locale } from '../data/nav';
import {
  FOOTER_ABOUT_LINKS,
  FOOTER_PRODUCT_LINKS,
  FOOTER_GENERAL_LINKS,
  FOOTER_CONTACT,
  FOOTER_SOCIAL,
  FOOTER_APPS,
  FOOTER_PAYMENT_IMAGE,
  TRUST_BADGE_LOGOS,
} from '../data/footer';

const currentLocale = (Astro.currentLocale ?? 'tr') as Locale;
const t = getTranslations(currentLocale);
const l = (slug: string) => getRelativeLocaleUrl(currentLocale, slug);

// Bu sayfaların gerçek per-locale slug'ı, `FOOTER_ABOUT_LINKS`/
// `FOOTER_GENERAL_LINKS`'teki (dil-nötr, tek TR slug varsayan) sabit
// slug'dan FARKLI — ör. İletişim EN'de `contact`, IT'de `contatti`. Bu
// eşleme, ilgili `key`'e sahip linkler için generic `l(item.slug)` yerine
// kullanılıyor (bkz. aşağıdaki render — ÜRÜNLER mega-menüsünde kurulan
// aynı desen, `navigation.ts`'teki `contactHref()`/`globalBrandHref()` vb.).
const SPECIAL_HREFS: Partial<Record<string, string>> = {
  story: getAboutSlug(currentLocale) ?? 'hakkimizda',
  kvkk: getKvkkSlug(currentLocale) ?? 'kisisel-verilerin-korunmasi',
  pricing: getPricingSlug(currentLocale) ?? 'fiyatlar',
  contact: getContactSlug(currentLocale) ?? 'iletisim',
  // About kolonundaki "Güvenlik" — 6 hukuki belgeye link veren LİSTE
  // sayfası (`SecurityPage.astro`/`getSecurityMeta()`).
  security: getSecuritySlug(currentLocale) ?? 'guvenlik',
  // GENEL kolonundaki "Gizlilik ve Güvenlik Politikası" — yukarıdaki
  // `security`'den TAMAMEN AYRI bir sayfa: gerçek paragraf içerikli bir
  // gizlilik politikası MAKALESİ (`sozlesme/gizlilik-ve-guvenlik-politikasi`,
  // `LegalContent`/`content_block`). Önceki bir turda bu ikisi yanlışlıkla
  // aynı sayfa sanılıp buraya da `getSecuritySlug()` bağlanmıştı — kullanıcı
  // düzeltmesiyle (2026-07-24) ayrıştırıldı, bkz. CLAUDE.md.
  securityPolicy: getPrivacySecuritySlug(currentLocale) ?? 'sozlesme/gizlilik-ve-guvenlik-politikasi',
  globalBrand: getGlobalBrandSlug(currentLocale) ?? 'hedef-global-marka',
  // az'ın `i18n.fallback` hedefi 'tr' (en değil, bkz. astro.config.mjs) —
  // EN'in slug'ına ('faq') düşmek `/az/faq/` için var olmayan bir fallback
  // hedefi arıyordu (TR'nin gerçek slug'ı `sss`), stub hiç üretilmiyordu.
  faq: getFaqSlug(currentLocale) ?? getFaqSlug(currentLocale === 'az' ? 'tr' : 'en') ?? 'sss',
  advantages: getWhyIdenfitSlug(currentLocale) ?? 'neden-idenfit',
  consumerRights: getLegalSlug(CONSUMER_RIGHTS_TR_SLUG, currentLocale) ?? 'sozlesme/tuketici-haklari',
  distanceSalesAgreement: getLegalSlug(DISTANCE_SALES_TR_SLUG, currentLocale) ?? 'sozlesme/mesafeli-satis-sozlesmesi',
};

// ÜRÜNLER kolonu — `FOOTER_PRODUCT_LINKS`'teki `slug` çoğunlukla
// `products.json`'ın trSlug'ıyla birebir aynı, ama Özlük Dosyası'nın
// gerçek trSlug'ı `-2` sonekli (bkz. `productContent.ts`/`navigation.ts`'teki
// aynı not — WP'nin ham `slug` alanından türedi). Donanım ayrı bir ürün
// sayfası değil, kendi slug fonksiyonuna sahip (`hardwareContent.ts`).
// Mega-menünün `productHref()`/`hardwareHref()` (`navigation.ts`) ile aynı
// desen — önceden bu kolon hâlâ generic `l(item.slug)` kullanıyordu, bu
// yüzden EN/NL/IT'de 8 linkten 7'si 404 veriyordu.
const PRODUCT_TR_SLUG_OVERRIDES: Partial<Record<string, string>> = {
  'calisan-ozluk-yonetimi-modulu': 'calisan-ozluk-yonetimi-modulu-2',
};
const productFooterHref = (slug: string) => {
  if (slug === 'donanim') return l(getHardwareSlug(currentLocale) ?? 'donanim');
  const trSlug = PRODUCT_TR_SLUG_OVERRIDES[slug] ?? slug;
  return l(getProductSlug(trSlug, currentLocale) ?? slug);
};

const year = new Date().getFullYear();
const copyright = t.footer.copyright.replace('{year}', String(year));

// Sosyal ikonlar — lucide-react marka logosu içermediği için (yalnızca jenerik
// arayüz ikonları var) statik .astro içinde inline SVG olarak tutuluyor;
// bu şekilde hiçbir client JS gönderilmiyor (mimari kuralımıza uygun).
// `export`: İletişim sayfası (2026-08-11, KARAR 2) AYNI 7 platformu +
// AYNI ikon path'lerini sayfa içinde de gösteriyor — Footer'daki tek
// kaynaktan yeniden kullanılıyor, ikinci bir path seti YAZILMADI.
export const SOCIAL_ICON_PATHS: Record<string, { viewBox: string; path: string }> = {
  linkedin: {
    viewBox: '0 0 24 24',
    path:
      'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z',
  },
