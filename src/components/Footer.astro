// Uygulama mağazası ikonları (Apple/Android) — SOCIAL_ICON_PATHS'ten AYRI
// tutuluyor çünkü kaynakta birden fazla `<path>` alt-elemanı içeriyorlar
// (tek bir `d` stringine sıkıştırılamıyor).
const APP_ICON_PATHS: Record<string, { viewBox: string; paths: string[] }> = {
  apple: {
    viewBox: '0 0 512 512',
    paths: [
      'M185.255,512c-76.201-0.439-139.233-155.991-139.233-235.21c0-129.404,97.075-157.734,134.487-157.734c16.86,0,34.863,6.621,50.742,12.48c11.104,4.087,22.588,8.306,28.975,8.306c3.823,0,12.832-3.589,20.786-6.738c16.963-6.753,38.071-15.146,62.651-15.146c0.044,0,0.103,0,0.146,0c18.354,0,74.004,4.028,107.461,54.272l7.837,11.777l-11.279,8.511c-16.113,12.158-45.513,34.336-45.513,78.267c0,52.031,33.296,72.041,49.292,81.665c7.061,4.248,14.37,8.628,14.37,18.208c0,6.255-49.922,140.566-122.417,140.566c-17.739,0-30.278-5.332-41.338-10.034c-11.191-4.761-20.845-8.862-36.797-8.862c-8.086,0-18.311,3.823-29.136,7.881C221.496,505.73,204.752,512,185.753,512H185.255z',
      'M351.343,0c1.888,68.076-46.797,115.304-95.425,112.342C247.905,58.015,304.54,0,351.343,0z',
    ],
  },
  android: {
    viewBox: '0 0 512.034 512.034',
    paths: [
      'M362.684,192.034H149.35c-5.888,0-10.667,4.779-10.667,10.667v170.667c0,25.771,18.347,47.296,42.667,52.267v54.4c0,17.643,14.357,32,32,32c17.643,0,32-14.357,32-32v-53.333h21.333v53.333c0,17.643,14.357,32,32,32s32-14.357,32-32v-54.4c24.32-4.949,42.667-26.496,42.667-52.267V202.701C373.35,196.792,368.572,192.034,362.684,192.034z',
      'M311.846,56.845l17.984-41.963c2.325-5.419-0.192-11.669-5.611-13.995c-5.355-2.347-11.691,0.171-13.995,5.611l-17.984,41.984c-11.413-3.712-23.573-5.781-36.203-5.781c-12.629,0-24.789,2.069-36.203,5.781L201.809,6.498c-2.304-5.44-8.64-7.979-13.995-5.611c-5.419,2.325-7.915,8.597-5.589,13.995l17.984,41.963c-36.629,19.883-61.525,58.688-61.525,103.189c0,5.888,4.779,10.667,10.667,10.667h213.333c5.888,0,10.667-4.779,10.667-10.667C373.35,115.533,348.454,76.728,311.846,56.845z M213.35,128.034c-5.888,0-10.667-4.779-10.667-10.667s4.779-10.667,10.667-10.667s10.667,4.779,10.667,10.667S219.238,128.034,213.35,128.034z M298.684,128.034c-5.888,0-10.667-4.779-10.667-10.667s4.779-10.667,10.667-10.667s10.667,4.779,10.667,10.667S304.572,128.034,298.684,128.034z',
