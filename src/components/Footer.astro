---

<footer class="bg-footer-bg text-white">
	<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
			<!-- Kolon 1: marka + iletişim + sosyal medya -->
			<div>
				<a href={l('')} class="inline-block text-white" aria-label="idenfit">
					<IdenfitLogo className="h-8 w-auto" />
				</a>
				<p class="mt-4 text-base leading-relaxed text-white/70">{FOOTER_CONTACT.address}</p>
				<a href={FOOTER_CONTACT.phoneHref} class="mt-2 block text-base text-white/70 transition-colors hover:text-white">
					{FOOTER_CONTACT.phoneLabel}
				</a>
				<a href={FOOTER_CONTACT.emailHref} class="mt-1 block text-base text-white/70 transition-colors hover:text-white">
					{FOOTER_CONTACT.emailLabel}
				</a>

				<ul class="mt-5 flex flex-wrap items-center gap-3">
					{
						FOOTER_SOCIAL.map((social) => {
							const icon = SOCIAL_ICON_PATHS[social.platform];
							return (
								<li>
									<a
										href={social.href}
										target="_blank"
										rel="noopener noreferrer nofollow"
										aria-label={social.label}
										class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-brand"
									>
										<svg width="16" height="16" viewBox={icon.viewBox} fill="currentColor" aria-hidden="true">
											<path d={icon.path} />
										</svg>
									</a>
								</li>
							);
						})
					}
				</ul>

				<!-- Uygulama mağazası ikonları — kaynakta sosyal ikonların hemen
				     altında, aynı stilde ayrı bir satır. -->
				<ul class="mt-3 flex items-center gap-3">
					{
						FOOTER_APPS.map((app) => {
							const icon = APP_ICON_PATHS[app.platform];
							return (
								<li>
									<a
										href={app.href}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={app.label}
										class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-brand"
									>
										<svg width="16" height="16" viewBox={icon.viewBox} fill="currentColor" aria-hidden="true">
											{icon.paths.map((d) => (
												<path d={d} />
											))}
										</svg>
									</a>
								</li>
							);
						})
					}
				</ul>
			</div>

			<!-- Kolon 2: HAKKINDA -->
			<div>
				<h3 class="text-lg font-bold tracking-wide text-white">{t.footer.columnTitles.about}</h3>
				<ul class="mt-4 flex flex-col gap-2.5">
					{
						FOOTER_ABOUT_LINKS.map((item) => (
							<li>
								<a
									href={l(SPECIAL_HREFS[item.key] ?? item.slug)}
									class="text-base text-white/70 transition-colors hover:text-white"
								>
									{t.footer.links.about[item.key]}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Kolon 3: ÜRÜNLER -->
			<div>
				<h3 class="text-lg font-bold tracking-wide text-white">{t.footer.columnTitles.products}</h3>
				<ul class="mt-4 flex flex-col gap-2.5">
					{
						FOOTER_PRODUCT_LINKS.map((item) => (
							<li>
								<a href={productFooterHref(item.slug)} class="text-base text-white/70 transition-colors hover:text-white">
									{t.footer.links.products[item.key]}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Kolon 4: GENEL -->
			<div>
				<h3 class="text-lg font-bold tracking-wide text-white">{t.footer.columnTitles.general}</h3>
				<ul class="mt-4 flex flex-col gap-2.5">
					{
						FOOTER_GENERAL_LINKS.map((item) => (
							<li>
								<a
									href={l(SPECIAL_HREFS[item.key] ?? item.slug)}
									class="text-base text-white/70 transition-colors hover:text-white"
								>
									{t.footer.links.general[item.key]}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<!-- Alt bar: güven rozetleri + ödeme yöntemleri + telif hakkı + yasal
		     linkler — footer'ın kendi gri zemininin İÇİNDE (bir öncekinin
		     aksine, footer'ın ALTINA taşan ayrı beyaz bir şerit DEĞİL).
		     Güven rozetleri kullanıcının verdiği sırayla (SSL→ISO→Peryön→GDPR),
		     ödeme yöntemi rozeti (kullanıcı isteğiyle GENEL kolonundan buraya
		     taşındı) AYNI satırda sağa hizalı (`sm:ml-auto`) — diğer
		     logolarla aynı yükseklikte/kart stilinde. Çoğu beyaz/şeffaf
		     zeminli bu logolar gri fonda çıplak bırakılırsa (özellikle opak
		     beyaz kare olan SSL/ISO) tutarsız görünür, bu yüzden her biri
		     kendi küçük beyaz kartında. -->
		<div class="mt-10 flex flex-wrap items-center justify-center gap-3 border-t border-white/10 pt-6 sm:justify-start">
			{
				TRUST_BADGE_LOGOS.map((badge) => (
					<div class="flex h-16 items-center rounded-lg bg-white/95 px-4 sm:h-[4.5rem]">
						<img src={badge.src} alt={t.footer.trustBadges[badge.key]} loading="lazy" class="h-10 w-auto object-contain sm:h-12" />
					</div>
				))
			}
			<div class="rounded bg-white/95 p-2 sm:ml-auto">
				<img
					src={FOOTER_PAYMENT_IMAGE}
					alt={t.footer.paymentMethodsAlt}
					loading="lazy"
					class="h-auto w-full max-w-[220px] object-contain"
				/>
			</div>
		</div>

		<div class="mt-6 flex flex-col items-center gap-3 pt-0 text-xs text-white/60 sm:flex-row sm:justify-between">
			<p>{copyright}</p>
			<ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
