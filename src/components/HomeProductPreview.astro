---
// İnteraktif "ürün önizleme" widget'ı (2026-08-13) — gerçek app.idenfit.com
// panel ekran görüntülerine dayanan tasarım, bkz. `ProductPreviewWidget.tsx`.
// PİLOT: yalnızca TR ana sayfasına eklendi (kurgusal veri + Türkçe etiketler
// gerektirdiği için i18n kapsamı onay sonrasına bırakıldı, bkz. CLAUDE.md).
// Sayfanın üst kısmında olduğu için `client:visible` (ilk ekranda değil
// ama erken scroll'da hydrate — `PanelFeatureSection`'ın formu gibi).
//
// Marka çerçevesi (2026-08-13, kullanıcı geri bildirimi — "idenfit
// arayüzü eklenmemiş, markamız belli olmuyor"): `LandingProductShowcase.astro`'nun
// ZATEN KANITLANMIŞ "sahte tarayıcı çerçevesi" deseni (koyu üst bar +
// gerçek ekosistem hostname'i `app.idenfit.com`, bkz. CLAUDE.md §Mimari
// "CTA URL çözümleme" — uydurma bir alan adı DEĞİL) buraya da uygulandı,
// ikinci bir görsel dil İCAT EDİLMEDİ. Gerçek idenfit logotype'ı (kaynak:
// `IdenfitLogo.tsx`, Header/Footer'la AYNI SVG) ARTIK yalnızca
// `ProductPreviewWidget.tsx`'in kendi içeriğinde (dashboard mockup'ının
// sol üstünde, gerçek üründeki sidebar konumu gibi) render ediliyor —
// bu bar'daki küçük beyaz kopya (ikinci bir tur, kullanıcı talebiyle)
// gereksiz tekrar olduğu için KALDIRILDI, tek/daha güçlü bir marka
// vurgusu bırakıldı.
import ProductPreviewWidget from './ProductPreviewWidget.tsx';
import WidgetAccentBackdrop from './WidgetAccentBackdrop.astro';
---

<section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="h2-section text-heading">Panelinizde Sizi Neler Bekliyor?</h2>
    <p class="mt-4 text-body">
      idenfit panelinden gerçek zamanlı bir kesit — vardiya devam oranları, izin talepleri ve ekip verileriniz tek bir ekranda.
    </p>
  </div>
  {/* Widget'ın arkasına idenfit kırmızısı tonlarında yumuşak bir radyal
      gradyan "tuval" eklendi (2026-08-18, kullanıcı talebi — referans bir
      ekran görüntüsündeki mor/pembe degrade zeminin AYNI ilkesi, marka
      kırmızısıyla). Yalnızca sabit padding/border-radius kullanıyor —
      önceki terk edilmiş "ağ" deseninin (WidgetNetworkBackground, artık
      silinmiş) yüzde-tabanlı taşma riski YOK, bkz. CLAUDE.md. */}
  <div
    class="mt-10 rounded-[2rem] p-4 sm:p-8 lg:p-10"
    style="background: radial-gradient(120% 100% at 50% 0%, #FFDCDC 0%, #FFF3F3 55%, #FFFFFF 100%);"
  >
    <div class="group relative">
      <WidgetAccentBackdrop />
      <div class="reveal relative z-10 overflow-hidden rounded-2xl shadow-[0_14px_50px_rgba(138,0,0,0.16)]">
        <div class="flex items-center gap-3 bg-[#1F2937] px-4 py-3 sm:px-6">
          <div class="flex gap-1.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
          </div>
          <span class="flex-1 truncate rounded-md bg-white/10 px-3 py-1 text-center text-xs text-white/50">app.idenfit.com</span>
        </div>
        <ProductPreviewWidget client:visible />
      </div>
    </div>
  </div>
</section>
