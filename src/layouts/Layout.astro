---
import '../styles/global.css';
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<!-- Quicksand (idenfit.com marka fontu) — self-hosted, bkz. global.css'in
		     @font-face yorumu. -->
		<link
			rel="preload"
			href="/fonts/quicksand/quicksand-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/quicksand/quicksand-latin-ext.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<title>Astro Basics</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
