---
// Landing Page (`/demo`) — `BaseLayout.astro`'nun `<head>` bloğunu birebir
// taşır (Quicksand font, favicon, meta, `noscript`/`.reveal` fallback,
// `noindex` desteği) ama `<body>`'de tam `Header`/`Footer`/
// `FloatingContactButtons` yerine minimal `LandingHeader`/`LandingFooter`
// kullanır — kullanıcı kararı: reklam trafiği ziyaretçisi formda tutulsun,
// siteye dağıtacak nav olmasın (bkz. CLAUDE.md 2026-08-06 günlüğü).
import '../styles/global.css';
import LandingHeader from '../components/LandingHeader.astro';
import LandingFooter from '../components/LandingFooter.astro';
import { HOME_PANEL_IMAGE } from '../data/homeContent';

interface Props {
  title?: string;
  description?: string;
  /** `BaseLayout.astro`'daki AYNI `noindex` prop'u — burada varsayılan
   * `true` (landing sayfaları için güvenli varsayılan, aksine ihtiyaç
   * olursa açıkça `noindex={false}` verilebilir). */
  noindex?: boolean;
  /** `BaseLayout.astro`'daki AYNI `image`/`ogType` prop çifti (2026-08-13,
   * "og:image eksik" SEO uyarısı turu) — bkz. o dosyadaki tam yorum.
   * Landing sayfası TR-only olduğu için varsayılan görsel her zaman
   * `HOME_PANEL_IMAGE.tr` (locale bazlı seçim gerekmiyor). */
  image?: string;
  ogType?: 'website' | 'article';
}

const {
  title = 'idenfit',
  description = 'idenfit — İnsan kaynakları yönetim yazılımı.',
  noindex = true,
  image,
  ogType = 'website',
} = Astro.props;

const ogImage = image ?? HOME_PANEL_IMAGE.tr.url;
// `BaseLayout.astro`'daki AYNI ilke (bkz. o dosyadaki tam yorum) — `site`
// alanı boşken uydurma bir domain kullanılmıyor, göreli yola düşülüyor.
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{/* Canonical (2026-08-17) — `BaseLayout.astro`'daki AYNI ilke: `site`
		    boşken hiç üretilmez. hreflang burada YOK — bu sayfa TR-only
		    (tek dil), bildirilecek bir alternatif yok. */}
		{Astro.site && !noindex && <link rel="canonical" href={pageUrl} />}

		<!-- Open Graph + Twitter Card — `BaseLayout.astro`'daki AYNI blok
		     (2026-08-13, "og:image eksik" SEO uyarısı turu). -->
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Quicksand (idenfit.com marka fontu) — self-hosted, bkz. global.css'in
		     @font-face yorumu (Google Fonts'un GDPR/IP-sızıntı riski nedeniyle
		     2026-08-31'de taşındı). -->
		<link
			rel="preload"
			href="/fonts/quicksand/quicksand-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/quicksand/quicksand-latin-ext.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<title>{title}</title>
		<!-- JS tamamen kapalıysa scroll-reveal script'i hiç çalışmaz — `.reveal`
		     öğelerinin görünmez kalmaması için (bkz. global.css) burada zorla
		     tam görünür yapılıyor. -->
		<noscript>
			<style>
				.reveal {
					opacity: 1 !important;
					transform: none !important;
				}
			</style>
		</noscript>
	</head>
	<body class="min-h-screen bg-surface text-body font-sans antialiased">
		<LandingHeader />
		<main>
			<slot />
		</main>
		<LandingFooter />
	</body>
</html>

<style>
	/* Sayfa geneli çok hafif nokta-grid dokusu (2026-08-07, KONU 5 —
	   "boş beyaz alan" hissini azaltmak için). `:global(body)` kullanıldığı
	   için Astro'nun otomatik scoping'ini atlıyor GİBİ görünse de, bu
	   stylesheet yalnızca `LandingLayout` kullanan sayfalara (şu an
	   yalnızca `/demo`) bundle edilip yükleniyor — diğer sayfalar
	   `BaseLayout`'u kullandığı için bu kural onlara HİÇ ulaşmıyor.
	   Marka kırmızısı %4 opaklıkta, 24px aralıklı tekrarlayan nokta —
	   abartısız, yalnızca çok yakından fark edilir. */
	:global(body) {
		background-image: radial-gradient(rgba(255, 0, 0, 0.04) 1px, transparent 1px);
		background-size: 24px 24px;
	}
</style>
