---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContactButtons from '../components/FloatingContactButtons.astro';
import { HOME_PANEL_IMAGE } from '../data/homeContent';
import { FOOTER_SOCIAL, FOOTER_CONTACT } from '../data/footer';
import { organizationId, safeJsonLd } from '../data/jsonLd';
import { buildHreflangAlternates, type HreflangAlternate } from '../i18n/hreflang';
import { getTranslations } from '../i18n';
import type { Locale } from '../data/nav';

/** Breadcrumb'ın "Ana Sayfa" SONRASI kısmı — 2026-08-24, "No BreadcrumbList
 * schema" GEO bulgusu. `href` verilmezse (son öğe = mevcut sayfa) hem
 * görsel breadcrumb'ta tıklanamaz düz metin olarak, hem JSON-LD'de mevcut
 * sayfanın kendi URL'i olarak render edilir. `label` çağıran sayfanın
 * ZATEN sahip olduğu gerçek başlıktan (`content.title`/`pageTitle`/
 * `hero.title` vb.) gelmeli — burada yeni bir metin İCAT EDİLMEZ. */
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title?: string;
  description?: string;
  /** Bkz. `Header.astro`'daki `localeUrls` prop açıklaması. */
  localeUrls?: Partial<Record<Locale, string>>;
  /** hreflang üretimi için GERÇEK içeriği olan locale listesi (2026-08-17,
   * "No hreflang tags" SEO turu — bkz. CLAUDE.md). Verilmezse TÜM diller
   * (`LOCALES`) varsayılır — sayfaların büyük çoğunluğu için doğru (4
   * dilde de gerçek dosya var). **Yalnızca gerçek bir dil eksikse** (ör.
   * NL'de kaynak sayfa hiç yok — KVKK/Güvenlik/SSS/Hub/Destek Talebi/
   * Teşekkürler/Gizlilik-Güvenlik/Tüketici Hakları/Mesafeli Satış ailesi;
   * ya da yalnızca TR+EN — Demirbaş/Seyahat; ya da yalnızca TR — Puantaj/
   * blog/Hesaplama Araçları/İK Dijital Olgunluk Testi) çağıran sayfa bu
   * prop'u AÇIKÇA kısıtlı geçirmeli. **`localeUrls`'in ham anahtarlarını
   * KULLANMA** — birçok `get*LocaleUrls()` fonksiyonu dil değiştirici için
   * eksik NL'yi EN'in URL'ine "alias"lıyor (bkz. `hreflang.ts`'in dosya
   * başı yorumu), bu hreflang için GEÇERSİZ bir sinyal olur. */
  hreflangLocales?: Locale[];
  /** `true` ise `<meta name="robots" content="noindex, nofollow">` eklenir
   * — arama motorlarından gizli, yalnızca doğrudan/reklam trafiğine açık
   * sayfalar için (ör. Landing Page `/demo`, bkz. CLAUDE.md 2026-08-06).
   * Varsayılan `false` (mevcut tüm sayfaların davranışı değişmez). */
  noindex?: boolean;
  /** Open Graph/Twitter Card paylaşım görseli (2026-08-13, "og:image eksik"
   * SEO uyarısı turu — bkz. CLAUDE.md). Mutlak bir URL bekleniyor — WP'nin
   * kendi hotlink edilen medya dosyaları (ör. `hero.image.url`, blog
   * `featuredImage.image`) zaten mutlak. Verilmezse ana sayfanın "Kullanıcı
   * Dostu Panel" dashboard görseline (`HOME_PANEL_IMAGE`, locale'e göre)
   * düşülür — kaynağın kendi Yoast `og_image`'i İNCELENDİ ama güvenilmez
   * çıktı (ör. ana sayfanın kendisi bir müşteri logosuna düşüyordu,
   * Yoast'ın "sayfadaki ilk görsel" otomatiği, kürasyonlu DEĞİL) — bu
   * yüzden kaynaktan taşınmadı, kendi markaya uygun varlığımız kullanıldı. */
  image?: string;
  /** `og:type` — blog yazıları `article` geçirir, geri kalan HER ŞEY
   * (varsayılan) `website`. */
  ogType?: 'website' | 'article';
  /** "No Open Graph article date tags" GEO bulgusu (2026-08-19) —
   * `article:published_time`/`article:modified_time`, yalnızca
   * `ogType="article"` iken ANLAMLI (OG spec'i bu alanları `og:type`
   * `article` olan sayfalar için tanımlıyor). Yalnızca blog yazısı
   * sayfası (`blog/[slug].astro`) geçiriyor — JSON-LD'nin `datePublished`/
   * `dateModified`'ıyla AYNI `date`/`modifiedDate` verisinden, ikinci bir
   * veri kaynağı İCAT EDİLMEDİ. ISO 8601 string bekleniyor. */
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  /** "No dateModified in structured data" GEO bulgusu (2026-08-19) —
   * `WebPage` JSON-LD bloğunun `dateModified` alanı. Yalnızca GERÇEK bir
   * WP `modified` tarihi geçirilmeli (`get*ModifiedDate()` fonksiyonları,
   * "No visible content dates" turu, 2026-08-17) — uydurma tarih YOK.
   * ISO 8601 string bekleniyor.
   *
   * **2026-10-02 (PR 4) — DAVRANIŞ DEĞİŞİKLİĞİ:** bu prop ESKİDEN
   * `WebPage` bloğunun TAMAMININ ön koşuluydu; verilmeyen sayfalar
   * (ana sayfa, hub'lar, SSS, 404 — gerçek `modified` verisi olmayan
   * türler) HİÇBİR `WebPage` şeması almıyordu, yani şema seviyesinde
   * kimlikleri yoktu. Artık blok KOŞULSUZ basılıyor ve `dateModified`
   * yalnızca OPSİYONEL bir ALAN — 146 sayfa `name`/`description`/`url`/
   * `publisher` kazandı. Tarihi OLAN 163 sayfanın çıktısı BAYT BAYT
   * aynı kaldı (alanın nesne içindeki KONUMU korundu, `JSON.stringify`
   * anahtar sırasını ekleme sırasına göre üretiyor).
   *
   * Blok hâlâ YALNIZCA `ogType !== 'article'` iken basılıyor: blog kendi
   * `BlogPosting` JSON-LD'sini `blog/[slug].astro`'da üretiyor, çift blok
   * olmasın diye.
   *
   * **Not:** yukarıdaki HTML yorumu hâlâ "dateModified JSON-LD notu"
   * diyor — metni düzeltmek 949 sayfanın HTML'inde bayt değiştirirdi
   * (Astro şablon yorumlarını çıktıya basıyor, bkz. CLAUDE.md'deki
   * kalıcı ders) ve PR 4'ün "mevcut çıktı değişmeyecek" şartını
   * bozardı. Bilinçli olarak eski metinle bırakıldı. */
  dateModified?: string;
  /** "No BreadcrumbList schema" GEO bulgusu (2026-08-24) — bkz.
   * `BreadcrumbItem` yorumu. "Ana Sayfa" SONRASI iz; verilmezse (ana
   * sayfa, 404, Landing Page gibi) hiçbir breadcrumb render edilmez —
   * `dateModified`/`LastUpdated` ile AYNI "yalnızca gerçek veri varsa"
   * ilkesi. */
  breadcrumb?: BreadcrumbItem[];
  /** Sayfanın kendi hero'sunun İLK rengi (2026-08-29, kullanıcı bulgusu —
   * "her sayfada bulunan bu beyaz boşluk"): breadcrumb her zaman düz
   * beyaz zeminde render edilir, hemen altındaki sayfaya özel renkli/
   * gradyanlı hero'yla arasında (renkli hero kullanan sayfalarda) görünür
   * bir "dikiş"/beyaz şerit bırakırdı. Verilirse breadcrumb'ı saran
   * kutuya AYNI düz renk uygulanır — hero'nun KENDİ gradyanının en üst
   * (0%) rengiyle birebir eşleştirilmeli (ör.
   * `PresentationRequestPage.astro`'nun `#FFDCDC`'si) ki breadcrumb'ın
   * alt kenarıyla hero'nun üst kenarı aynı renkte buluşup KESİNTİSİZ
   * görünsün — gradyanın TAMAMINI burada tekrar ÜRETMEYE çalışmak
   * (farklı yükseklikteki 2 ayrı kutuda aynı yüzde-tabanlı gradyanı
   * hizalamak) kırılgan/tutarsız olurdu, bu yüzden bilinçli olarak yalnızca
   * DÜZ renk. Verilmezse (varsayılan, mevcut TÜM sayfaların davranışı)
   * breadcrumb şeffaf/beyaz kalır — DEĞİŞİKLİK YOK. */
  heroBackground?: string;
}

const {
  title = 'idenfit',
  description = 'idenfit — İnsan kaynakları yönetim yazılımı.',
  localeUrls,
  hreflangLocales,
  noindex = false,
  image,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  dateModified,
  breadcrumb,
  heroBackground,
} = Astro.props;

// Dil, Astro i18n routing'inden dinamik gelir (varsayılan: tr).
const lang = Astro.currentLocale ?? 'tr';
const t = getTranslations(lang as Locale);

// Breadcrumb — "Ana Sayfa" BaseLayout tarafından otomatik eklenir, çağıran
// sayfa yalnızca kendi izini geçirir (tek kaynaktan besleme, `Header.astro`
// ile AYNI `getRelativeLocaleUrl()` deseni). `noindex` sayfalarda (404,
// Landing Page) zaten `breadcrumb` prop'u hiç geçirilmiyor.
const breadcrumbTrail: BreadcrumbItem[] =
  breadcrumb && breadcrumb.length > 0
    ? [{ label: t.common.home, href: getRelativeLocaleUrl(lang, '') }, ...breadcrumb]
    : [];
const toAbsoluteUrl = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);

// `Organization` şemasının logosu — `blog/[slug].astro`'nun publisher.logo'su
// ile AYNI gerçek dosya (ikinci bir varlık üretilmedi). Google Organization
// için `logo`/`address`/`contactPoint` öneriyor; üçü de aşağıda
// `FOOTER_CONTACT`'tan besleniyor — footer'da görünen veriyle aynı tek kaynak.
const IDENFIT_ORG_LOGO = '/wp-content/uploads/2025/07/idenfit-logo.svg';

// `Organization` şemasının KANONİK KİMLİĞİ (2026-10-02, PR 2). Bu blok
// 3176 sayfanın HER BİRİNDE basılıyor ama `@id` olmadığı için tüketiciler
// (Google, LLM'ler) bunların AYNI kuruluş mu yoksa 3176 ayrı kuruluş mu
// olduğunu bilemiyordu. Sabit bir `@id` hepsini tek bir varlıkta
// birleştiriyor; `BlogPosting.publisher`/`author` ve aşağıdaki
// `WebPage.publisher` kuruluşu YENİDEN TANIMLAMAK yerine `{'@id': …}`
// ile buna REFERANS veriyor (2026-10-02, PR 3). Dize `organizationId()`
// ile PAYLAŞILAN tek kaynaktan geliyor — `blog/[slug].astro` da aynı
// fonksiyonu çağırıyor, iki yerde ayrı ayrı kurulmuyor.
// `url` ile AYNI koşula bağlı: `Astro.site` tanımsızken mutlak bir `@id`
// üretilemez ve göreli bir `@id` kimlik olarak işe yaramaz — o durumda
// hiç basılmıyor.
const IDENFIT_ORG_ID = organizationId(Astro.site);

// `areaServed` (2026-10-02, PR 2) — DÖRT ülke. İki farklı kanıt türünden
// besleniyor, ikisi de gerçek:
//
//  1) FİZİKSEL OFİS — `/iletisim/` sayfasında herkese açık şekilde
//     doğrulanabilir (kaynak: `reference/wordpress-export/misc-pages.json`,
//     `iletisim`):
//       TR — "İstanbul Merkez Ofisi" (Ümraniye) + "İstanbul Ar-Ge Ofisi"
//            (Teknopark/Pendik — `FOOTER_CONTACT.address` ile AYNI adres)
//       NL — "Lahey Global Satış Ofisi" (Den Haag)
//
//  2) GERÇEK SATIŞ FAALİYETİ, ofis YOK — IT ve AZ.
//     **Bu bilgi kod tabanından/kaynak siteden TÜRETİLEMEZ**; kullanıcının
//     (sude@idenfit.com) 2026-10-02'de verdiği ticari bilgiye dayanıyor:
//     "o ülkelerde gerçek müşterilerimiz var, ofis yok ama satış faaliyeti
//     var." Sitedeki dolaylı izler bununla TUTARLI (tam yerelleştirilmiş
//     IT/AZ sayfaları + € fiyat) ama tek başlarına kanıt sayılmamıştı —
//     kararın dayanağı bu iç bilgi, site içeriği değil.
//     **Değiştirilmeden önce iş tarafına sorulmalı** (kodda doğrulanabilecek
//     bir kaynağı yok).
//
// BİLİNÇLİ OLARAK DIŞARIDA BIRAKILANLAR (kullanıcı onaylı, 2026-10-02):
//  - **"MENA":** kaynakta yalnızca bir OFİS ADI olarak geçiyor ("MENA Sales
//    Office", EN/NL/IT iletişim sayfası) — schema.org'un beklediği
//    Place/AdministrativeArea karşılığı olmayan serbest metin bir bölge adı.
//  - **"Worldwide" / 3 kıta:** `hedef-global-marka` sayfası bunu AÇIKÇA
//    2027 HEDEFİ olarak anlatıyor ("Vizyonumuz, 2027 yılında … en az 3
//    kıtada aktif olarak kullanılması") — bugünkü bir gerçek değil, şemaya
//    yazmak yanlış beyan olurdu.
const IDENFIT_AREA_SERVED = ['TR', 'NL', 'IT', 'AZ'];

// OG/Twitter görseli — sayfaya özgü verilmemişse ana sayfanın dashboard
// mockup'ına (locale'e göre — NL kendi farklı görselini kullanıyor, bkz.
// `HOME_PANEL_IMAGE`'in kendi yorumu) düşülür.
// `og:image`/`twitter:image` MUTLAK URL zorunlu (ogp.me spec) — göreli bir
// yol verildiğinde LinkedIn/Facebook/WhatsApp/X/Slack önizleme görselini
// HİÇ göstermez. 2026-09-07 denetiminde 938 sayfanın tamamında göreli
// olduğu ölçüldü: `site` alanı 2026-09-02'de doldurulup canonical/hreflang
// mutlağa geçerken bu iki etiket atlanmıştı. `toAbsoluteUrl` zaten mutlak
// olan bir değeri (ör. dış CDN görseli) olduğu gibi bırakır.
const ogImage = toAbsoluteUrl(image ?? HOME_PANEL_IMAGE[lang as Locale].url);

// `og:url` mutlak URL gerektiriyor (ogp.me spec). `site` alanı 2026-09-02'de
// dolduruldu, bu yüzden burası artık her zaman mutlak URL üretiyor;
// `Astro.site` tanımsız kalırsa (yalnızca yapılandırma kazası) göreli yola
// düşer ve canonical/hreflang de hiç üretilmez.
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

// Canonical + hreflang (2026-08-17, "No hreflang tags" SEO turu — bkz.
// CLAUDE.md). İkisi de `Astro.site` boşken (Faz 2 domain bağlanana kadar)
// HİÇ üretilmez — canonical/hreflang mutlak URL şart koşuyor, `pageUrl`'in
// yukarıdaki AYNI ilkesi. `noindex` sayfalarda da (404, redirect'e denk
// gelen stub'lar vb.) ikisi de bastırılır — bu sayfalar zaten indekslenmeyecek.
const hreflangAlternates =
  noindex ? [] : buildHreflangAlternates(Astro.site, Astro.url.pathname, localeUrls, hreflangLocales);
const xDefaultHref = hreflangAlternates.find((a) => a.locale === 'tr')?.href;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<Analytics />
		<!-- Cookie-Script çerez onay banner'ı — detaylı teknik notlar CLAUDE.md'de -->
		<script
			type="text/javascript"
			charset="UTF-8"
			src="https://geo.cookie-script.com/s/51784a7076ca28a76ff0b3b33b46e5a8.js?country=tr"
			id="cookie_script-js-with"
			is:inline></script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{Astro.site && !noindex && <link rel="canonical" href={pageUrl} />}

		<!-- hreflang (2026-08-17) — bkz. `hreflangAlternates` yorumu yukarıda.
		     Kendi kendine referans dahil (Google'ın gerekliliği), x-default
		     her zaman TR'ye (varsayılan dil) işaret eder. -->
		{hreflangAlternates.map((a: HreflangAlternate) => (
			<link rel="alternate" hreflang={a.locale} href={a.href} />
		))}
		{xDefaultHref && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}

		<!-- Open Graph (2026-08-13, "og:image eksik" SEO uyarısı turu — bkz.
		     `image`/`ogType` prop yorumları yukarıda). -->
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		{ogType === 'article' && articlePublishedTime && (
			<meta property="article:published_time" content={articlePublishedTime} />
		)}
		{ogType === 'article' && articleModifiedTime && (
			<meta property="article:modified_time" content={articleModifiedTime} />
		)}

		<!-- Organization JSON-LD notu — detaylı teknik notlar CLAUDE.md'de -->
		<script
			type="application/ld+json"
			set:html={safeJsonLd({
				'@context': 'https://schema.org',
				'@type': 'Organization',
				...(IDENFIT_ORG_ID ? { '@id': IDENFIT_ORG_ID } : {}),
				name: 'idenfit',
				...(Astro.site ? { url: Astro.site.href } : {}),
				// Sayfanın kendi diliyle gelir — yeni metin YAZILMADI,
				// `t.hero.description` ana sayfanın ZATEN canlı olan
				// `<meta name="description">` metni (5 dilin hepsinde gerçek
				// çeviri, bkz. `src/i18n/*.ts`). İkinci bir "kurumsal açıklama"
				// kaynağı uydurmak, iki metnin zamanla ayrışması demekti.
				description: t.hero.description,
				logo: toAbsoluteUrl(IDENFIT_ORG_LOGO),
				address: {
					'@type': 'PostalAddress',
					streetAddress: FOOTER_CONTACT.address,
					addressLocality: FOOTER_CONTACT.addressLocality,
					addressCountry: 'TR',
				},
				// `contactPoint` içindeki değerlerle AYNI tek kaynaktan
				// (`FOOTER_CONTACT`) besleniyor — Google `Organization`
				// dokümantasyonu bu ikisini üst seviyede de bekliyor.
				telephone: FOOTER_CONTACT.phoneLabel,
				email: FOOTER_CONTACT.emailLabel,
				areaServed: IDENFIT_AREA_SERVED,
				contactPoint: {
					'@type': 'ContactPoint',
					contactType: 'customer support',
					telephone: FOOTER_CONTACT.phoneLabel,
					email: FOOTER_CONTACT.emailLabel,
				},
				sameAs: FOOTER_SOCIAL.map((s) => s.href),
			})}
			is:inline
		/>

		<!-- dateModified JSON-LD notu — detaylı teknik notlar CLAUDE.md'de -->
		{ogType !== 'article' && (
			<script
				type="application/ld+json"
				set:html={safeJsonLd({
					'@context': 'https://schema.org',
					'@type': 'WebPage',
					name: title,
					description,
					url: pageUrl,
					// Kuruluş AYNI sayfada zaten tam olarak tanımlı (yukarıdaki
					// Organization bloğu) — burada yeniden tanımlanmıyor, yalnızca
					// referans veriliyor. `@id` üretilemiyorsa (bkz.
					// `organizationId()`) alan hiç basılmaz: tanımsız bir düğüme
					// atıf yapmaktansa `publisher`'ı hiç yazmamak doğru.
					...(IDENFIT_ORG_ID ? { publisher: { '@id': IDENFIT_ORG_ID } } : {}),
					// `dateModified` artık OPSİYONEL bir ALAN (2026-10-02, PR 4) —
					// eskiden bloğun TAMAMININ ön koşuluydu. Konumu ve koşullu
					// yazım biçimi, `publisher` ile AYNI nedenle değiştirilmedi:
					// `JSON.stringify` anahtar sırasını ekleme sırasına göre
					// koruyor, bu yüzden tarihi OLAN 163 sayfanın çıktısı
					// BAYT BAYT aynı kalıyor (byte diff ile doğrulandı).
					...(dateModified ? { dateModified } : {}),
				})}
				is:inline
			/>
		)}

		<!-- BreadcrumbList JSON-LD — detaylı teknik notlar CLAUDE.md'de -->
		{breadcrumbTrail.length > 0 && (
			<script
				type="application/ld+json"
				set:html={safeJsonLd({
					'@context': 'https://schema.org',
					'@type': 'BreadcrumbList',
					itemListElement: breadcrumbTrail.map((item, i) => ({
						'@type': 'ListItem',
						position: i + 1,
						name: item.label,
						item: toAbsoluteUrl(item.href ?? Astro.url.pathname),
					})),
				})}
				is:inline
			/>
		)}

		<!-- Twitter Card — Open Graph ile AYNI veriyi paylaşıyor, ayrı veri
		     TOPLANMADI (kullanıcı kararı). -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Quicksand self-hosted font notu — detaylı teknik notlar CLAUDE.md'de -->
		<link
			rel="preload"
			href="/fonts/quicksand/quicksand-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/quicksand/quicksand-latin-ext.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<title>{title}</title>
		<!-- JS tamamen kapalıysa scroll-reveal script'i hiç çalışmaz — `.reveal`
		     öğelerinin görünmez kalmaması için (bkz. global.css) burada zorla
		     tam görünür yapılıyor. -->
		<noscript>
			<style>
				.reveal {
					opacity: 1 !important;
					transform: none !important;
				}
			</style>
		</noscript>
	</head>
	<body class="min-h-screen bg-surface text-body font-sans antialiased">
		<Header localeUrls={localeUrls} />
		<main>
			<!-- Görünür breadcrumb — detaylı teknik notlar CLAUDE.md'de -->
			{breadcrumbTrail.length > 0 && (
				<div class="pb-3" style={heroBackground ? `background: ${heroBackground};` : undefined}>
					<nav aria-label="Breadcrumb" class="mx-auto max-w-7xl px-4 pt-4 sm:px-6 lg:px-8">
					<ol class="flex flex-wrap items-center gap-1.5 text-xs text-muted">
						{breadcrumbTrail.map((item, i) => (
							<li class="flex items-center gap-1.5">
								{i > 0 && <span aria-hidden="true">/</span>}
								{item.href && i < breadcrumbTrail.length - 1 ? (
									<a href={item.href} class="hover:text-brand hover:underline">
										{item.label}
									</a>
								) : (
									<span aria-current="page" class="text-body">
										{item.label}
									</span>
								)}
							</li>
						))}
					</ol>
				</nav>
				</div>
			)}
			<slot />
		</main>
		<Footer />
		<FloatingContactButtons />
	</body>
</html>
