---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContactButtons from '../components/FloatingContactButtons.astro';
import type { Locale } from '../data/nav';

interface Props {
  title?: string;
  description?: string;
  /** Bkz. `Header.astro`'daki `localeUrls` prop açıklaması. */
  localeUrls?: Partial<Record<Locale, string>>;
  /** `true` ise `<meta name="robots" content="noindex, nofollow">` eklenir
   * — arama motorlarından gizli, yalnızca doğrudan/reklam trafiğine açık
   * sayfalar için (ör. Landing Page `/demo`, bkz. CLAUDE.md 2026-08-06).
   * Varsayılan `false` (mevcut tüm sayfaların davranışı değişmez). */
  noindex?: boolean;
}

const {
  title = 'idenfit',
  description = 'idenfit — İnsan kaynakları yönetim yazılımı.',
  localeUrls,
  noindex = false,
} = Astro.props;

// Dil, Astro i18n routing'inden dinamik gelir (varsayılan: tr).
const lang = Astro.currentLocale ?? 'tr';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<!-- Quicksand (idenfit.com marka fontu) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<!-- JS tamamen kapalıysa scroll-reveal script'i hiç çalışmaz — `.reveal`
		     öğelerinin görünmez kalmaması için (bkz. global.css) burada zorla
		     tam görünür yapılıyor. -->
		<noscript>
			<style>
				.reveal {
					opacity: 1 !important;
					transform: none !important;
				}
			</style>
		</noscript>
	</head>
	<body class="min-h-screen bg-surface text-body font-sans antialiased">
		<Header localeUrls={localeUrls} />
		<main>
			<slot />
		</main>
		<Footer />
		<FloatingContactButtons />
	</body>
</html>
