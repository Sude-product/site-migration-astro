---
export const prerender = true;
import ProductPage from '../components/ProductPage.astro';
import { getGlobalBrandContent, getGlobalBrandLocaleUrls, getGlobalBrandTitle } from '../data/miscPagesContent';

const content = { ...getGlobalBrandContent('tr')!, faq: [] };
const pageTitle = getGlobalBrandTitle('tr');
const localeUrls = getGlobalBrandLocaleUrls();
---

<ProductPage content={content} pageTitle={pageTitle} localeUrls={localeUrls} />
