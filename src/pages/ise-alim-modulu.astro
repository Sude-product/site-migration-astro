---
export const prerender = true;
// Aşama 2 — onaylı 5 modülden biri (İşe Alım/ATS). Bkz. CLAUDE.md.
// NOT: NL karşılığı yok — kaynak sitede o sayfa yayınlanmamış (WP REST API
// 401 rest_forbidden döndürüyor), i18n.fallback NL isteklerini EN'e düşürür.
// 2026-09-02 — canlı site tamamen Hiringoz'a yeniden markalandı, hero
// artık uzun bir pazarlama cümlesi (`pageTitle` H1/breadcrumb için hâlâ
// bu cümle — `en/hardware.astro`'nun AYNI deseni); `<title>`/CTA anahtar
// kelimesi için kısa, gerçek bir isim ayrıca geçiriliyor.
import ProductPage from '../components/ProductPage.astro';
import { getProductContent, getProductLocaleUrls, getProductPageTitle, getProductModifiedDate } from '../data/productContent';
import { buildIdenfitTitle } from '../data/pageTitle';
import { HIRINGOZ_PARTNER_LOGO } from '../data/productTranslationOverrides';

const trSlug = 'ise-alim-modulu';
const content = getProductContent(trSlug, 'tr')!;
const pageTitle = getProductPageTitle(trSlug, 'tr');
const title = buildIdenfitTitle('İşe Alım Modülü', 'tr');
const ctaKeyword = 'İşe Alım Modülü';
const localeUrls = getProductLocaleUrls(trSlug);
const modified = getProductModifiedDate(trSlug, 'tr');
---

<ProductPage
  content={content}
  pageTitle={pageTitle}
  title={title}
  ctaKeyword={ctaKeyword}
  localeUrls={localeUrls}
  modified={modified}
  heroLayout="stacked"
  heroPartnerLogo={HIRINGOZ_PARTNER_LOGO}
/>
