---
import ProductPage from '../../components/ProductPage.astro';
import { getProductContent, getProductLocaleUrls, getProductPageTitle, getProductModifiedDate } from '../../data/productContent';

const trSlug = 'seyahat-ve-gorevlendirme-yonetimi-modulu';
const content = getProductContent(trSlug, 'az')!;
const pageTitle = getProductPageTitle(trSlug, 'az');
const localeUrls = getProductLocaleUrls(trSlug);
const modified = getProductModifiedDate(trSlug, 'az');
---

<ProductPage content={content} pageTitle={pageTitle} localeUrls={localeUrls} hreflangLocales={['tr', 'en', 'az']} modified={modified} />
