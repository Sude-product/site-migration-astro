---
// Düzen idenfit.com'un canlı tekil yazı sayfası incelenerek güncellendi
// (2026-07-24, bkz. CLAUDE.md "Blog tasarımı"): sağda sabit genişlikte bir
// sidebar (Popüler İçerikler + Yaklaşan Etkinlikler) var, "Benzer Yazılar"
// (kaynaktaki gerçek başlık) bölümü ise sidebar'ın ALTINDA değil, ana
// içerik+sidebar alanının TAMAMEN ALTINDA, tam genişlikte bir bölüm.
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import { estimateReadingMinutes, getAllBlogPosts, getRelatedPosts, formatBlogDate } from '../../data/blogContent';

// "No visible content dates" GEO bulgusu (2026-08-17) — bkz. CLAUDE.md.
// `modifiedDate` zaten JSON-LD `dateModified`'da kullanılıyordu ama sayfada
// GÖRÜNMÜYORDU. Yalnızca yayın tarihinden GERÇEKTEN farklıysa (≥1 gün —
// WP'nin kaydetme sırasında birkaç saniyelik "sahte" fark üretebilen
// davranışının gürültüsünü ele, gerçek düzenlemeyi göstermek için) görünür
// bir not ekleniyor; aynıysa (46/618 yazı) hiçbir şey basılmıyor.
const DAY_MS = 24 * 60 * 60 * 1000;

// "Benzer Yazılar" kartları da BlogListPage.astro'daki liste kartlarıyla
// AYNI hover dilini kullanıyor (görsel `group-hover:scale-110`, sabit
// `aspect-[4/3]` — kaynakta bu grid `.uicore-landscape-ratio.uicore-grid`
// varyantı, `padding-bottom:57%` ~ 7:4, burada Tailwind'in standart
// `4/3` oranıyla yakın/tutarlı bir değere yuvarlandı) + `.reveal`
// scroll animasyonu.

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const { title, metaTitle, date, excerpt, featuredImage, categories, modifiedDate, authorName } = post.data;
const { Content } = await render(post);

const allPosts = await getAllBlogPosts();
const relatedPosts = getRelatedPosts(allPosts, post);
// Kategoriler zaten çıkarma script'inde İSİM bazlı dedupe edilmiş (bkz.
// extract-blog-posts.mjs `resolveTerms()`) — idenfit.com'un kendisi bunu
// YAPMIYOR ve tekil yazı sayfasında "Güncel Bilgiler, Güncel Bilgiler" gibi
// aynı ismi iki kez gösteriyor (`guncel-bilgiler` + `guncel-bilgiler-tr`
// aynı isme sahip iki farklı WP kategori ID'si — canlı sitede doğrulandı,
// kaynağın kendi hatası). Bizim verimiz zaten temiz olduğu için burada
// yalnızca virgülle birleştirmek yeterli, ekstra bir dedupe GEREKMİYOR.
const categoryLabel = categories.map((c) => c.name).join(', ');
const showModifiedDate = modifiedDate && Math.abs(modifiedDate.getTime() - date.getTime()) >= DAY_MS;

// JSON-LD (BlogPosting, schema.org) — 2026-08-10, structured data turu.
// Site genelinde İLK JSON-LD uygulaması (daha önce hiç yoktu — bkz. CLAUDE.md
// "JSON-LD/dateModified" notu). `dateModified`: legacy yazılarda (posts.json)
// WP'nin gerçek `modified` alanından geliyor; göç etmiş `.md` yazılarında
// (Decap CMS, henüz düzenleme-tarihi takibi YOK) bu alan yok — bu durumda
// `date`'e (yayın tarihi) düşer ("hiç düzenlenmemişse mantıklı bir varsayım",
// kullanıcı kararı). `mainEntityOfPage.@id` göreli bir yol (`Astro.url.pathname`)
// — proje henüz kalıcı bir prod domain'e (`astro.config.mjs`'in `site` alanı)
// sahip değil, mutlak bir URL icat ETMEDİK; domain netleşince buraya
// `Astro.site` tabanlı mutlak bir URL eklenmeli. `publisher.logo` gerçek,
// canlı idenfit.com barındırılan logo dosyası (bkz. `IdenfitLogo.tsx`'in
// kaynak yorumu) — uydurulmadı.
const IDENFIT_LOGO_URL = 'https://idenfit.com/wp-content/uploads/2025/07/idenfit-logo.svg';
// `image` Google'ın Article/BlogPosting rich result'ları için ZORUNLU —
// `featuredImage: null` olan tek bilinen yazıda (bkz. CLAUDE.md "617/618
// geçerli featured_media", kaynağın kendi eksikliği) gerçek marka logosuna
// düşülüyor — uydurma bir görsel DEĞİL, zaten `publisher.logo` için
// kullanılan AYNI gerçek, barındırılan dosya.
//
// `author` (2026-08-24, "No author attribution" GEO bulgusu) — sabit
// `Organization` yerine, kaynakta GERÇEK bir ad-soyad varsa (`authorName`,
// bkz. `content.config.ts`) `Person` kullanılıyor; yoksa (yazının ~96%'ı —
// jenerik "idenfit editör" veya WP kullanıcı adı formatındaki bylines,
// kullanıcı kararıyla isim GÖSTERİLMİYOR) mevcut `Organization` fallback'i
// aynen korunuyor.
//
// `speakable` (2026-08-23, "No Speakable markup" GEO bulgusu) — Google'ın
// Speakable desteği pratikte esas olarak ABD'deki onaylı haber
// yayıncılarıyla sınırlı kaldı, genel bir sıralama/zengin-sonuç sinyali
// DEĞİL (kullanıcı onaylı kapsam kararı: düşük fayda ama sıfır risk/düşük
// efor, "zararı yok"). Yalnızca blog yazılarına eklendi (Speakable
// semantik olarak Article/BlogPosting içindir, ürün/sektör sayfalarının
// `WebPage` şemasına eklenmedi). CSS seçiciler aşağıdaki `#post-title`
// (`<h1>`) ve `.post-content > p:first-of-type` (yazının ilk paragrafı —
// hem göç etmiş Markdown hem legacy JSON kaynaklı yazılarda ilk eleman
// her zaman doğrudan bir `<p>`) hook'larına karşılık geliyor; ikisi de
// SADECE bu işaretleme için eklendi, görsel/stil etkisi YOK.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: excerpt,
  image: featuredImage?.url ?? IDENFIT_LOGO_URL,
  datePublished: date.toISOString(),
  dateModified: (modifiedDate ?? date).toISOString(),
  author: authorName ? { '@type': 'Person', name: authorName } : { '@type': 'Organization', name: 'idenfit', url: 'https://idenfit.com' },
  publisher: {
    '@type': 'Organization',
    name: 'idenfit',
    logo: { '@type': 'ImageObject', url: IDENFIT_LOGO_URL },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.pathname },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['#post-title', '.post-content > p:first-of-type'],
  },
};
---

<!-- Blog TR-only (mimari karar, bkz. CLAUDE.md "Blog dil stratejisi") —
     hreflangLocales={['tr']} tek dil olduğu için hiç <link> üretmez, ama
     BİLİNÇLİ olarak açıkça geçiriliyor (verilmezse BaseLayout'un varsayılan
     "tüm diller gerçek" varsayımı /en/blog/<slug>/ gibi aslında yalnızca
     redirect stub'ı olan bir URL'e YANLIŞ hreflang="en" üretirdi). -->
<BaseLayout
  title={`${metaTitle ?? title} — idenfit Blog`}
  description={excerpt}
  image={featuredImage?.url ?? IDENFIT_LOGO_URL}
  ogType="article"
  articlePublishedTime={date.toISOString()}
  articleModifiedTime={(modifiedDate ?? date).toISOString()}
  hreflangLocales={['tr']}
  breadcrumb={[{ label: 'Blog', href: '/blog/' }, { label: title }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="flex flex-col gap-12 lg:flex-row lg:items-start">
      <article class="min-w-0 max-w-3xl flex-1">
        <a href="/blog/" class="text-sm font-semibold text-brand hover:underline">← Blog</a>

        <header class="mt-6">
          {categoryLabel && <span class="text-xs font-bold uppercase tracking-wide text-brand">{categoryLabel}</span>}
          <h1 id="post-title" class="mt-2 text-3xl font-bold leading-tight tracking-tight text-heading sm:text-4xl">{title}</h1>
          <div class="mt-3 flex items-center gap-2 text-sm text-muted">
            <time datetime={date.toISOString()}>{formatBlogDate(date)}</time>
            <span aria-hidden="true">·</span>
            <span>{estimateReadingMinutes(post.body ?? '')} dakikalık okuma</span>
            {
              showModifiedDate && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>
                    Güncellendi: <time datetime={modifiedDate!.toISOString()}>{formatBlogDate(modifiedDate!)}</time>
                  </span>
                </>
              )
            }
          </div>
        </header>

        {
          featuredImage && (
            <img
              src={featuredImage.url}
              alt={featuredImage.alt}
              width={featuredImage.width}
              height={featuredImage.height}
              class="mt-8 w-full rounded-2xl object-cover"
            />
          )
        }

        <div class="post-content mt-8 max-w-none text-body [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-heading [&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:text-lg [&_h3]:font-bold [&_h3]:text-heading [&_p]:mt-4 [&_p]:leading-relaxed [&_a]:text-brand [&_a]:underline [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mt-1 [&_img]:my-6 [&_img]:rounded-2xl [&_img]:object-cover">
          <Content />
        </div>
      </article>

      <BlogSidebar allPosts={allPosts} />
    </div>

    {
      relatedPosts.length > 0 && (
        <section class="mt-16 border-t border-gray-100 pt-12">
          <h2 class="text-xl font-bold text-heading">Benzer Yazılar</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {relatedPosts.map((related, i) => (
              <a
                href={`/blog/${related.data.slug}/`}
                class="reveal group"
                style={`transition-delay: ${Math.min(i, 6) * 60}ms`}
              >
                {related.data.featuredImage && (
                  <span class="block aspect-[4/3] w-full overflow-hidden rounded-md">
                    <img
                      src={related.data.featuredImage.url}
                      alt={related.data.featuredImage.alt}
                      width={related.data.featuredImage.width}
                      height={related.data.featuredImage.height}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                    />
                  </span>
                )}
                {related.data.categories[0] && (
                  <span class="mt-2 block text-xs font-bold uppercase tracking-wide text-brand">
                    {related.data.categories[0].name}
                  </span>
                )}
                <h3 class="mt-1 text-sm font-semibold leading-snug text-heading transition-colors group-hover:text-brand">
                  {related.data.title}
                </h3>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>

  <script src="../../scripts/scroll-reveal.js"></script>
</BaseLayout>
