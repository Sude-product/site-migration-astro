---
// Düzen idenfit.com'un canlı tekil yazı sayfası incelenerek güncellendi
// (2026-07-24, bkz. CLAUDE.md "Blog tasarımı"): sağda sabit genişlikte bir
// sidebar (Popüler İçerikler + Yaklaşan Etkinlikler) var, "Benzer Yazılar"
// (kaynaktaki gerçek başlık) bölümü ise sidebar'ın ALTINDA değil, ana
// içerik+sidebar alanının TAMAMEN ALTINDA, tam genişlikte bir bölüm.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import { estimateReadingMinutes, getAllBlogPosts, getRelatedPosts, formatBlogDate } from '../../data/blogContent';

// "Benzer Yazılar" kartları da BlogListPage.astro'daki liste kartlarıyla
// AYNI hover dilini kullanıyor (görsel `group-hover:scale-110`, sabit
// `aspect-[4/3]` — kaynakta bu grid `.uicore-landscape-ratio.uicore-grid`
// varyantı, `padding-bottom:57%` ~ 7:4, burada Tailwind'in standart
// `4/3` oranıyla yakın/tutarlı bir değere yuvarlandı) + `.reveal`
// scroll animasyonu.

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const { title, date, modifiedDate, excerpt, featuredImage, categories, content } = post.data;

const allPosts = await getAllBlogPosts();
const relatedPosts = getRelatedPosts(allPosts, post);
// Kategoriler zaten çıkarma script'inde İSİM bazlı dedupe edilmiş (bkz.
// extract-blog-posts.mjs `resolveTerms()`) — idenfit.com'un kendisi bunu
// YAPMIYOR ve tekil yazı sayfasında "Güncel Bilgiler, Güncel Bilgiler" gibi
// aynı ismi iki kez gösteriyor (`guncel-bilgiler` + `guncel-bilgiler-tr`
// aynı isme sahip iki farklı WP kategori ID'si — canlı sitede doğrulandı,
// kaynağın kendi hatası). Bizim verimiz zaten temiz olduğu için burada
// yalnızca virgülle birleştirmek yeterli, ekstra bir dedupe GEREKMİYOR.
const categoryLabel = categories.map((c) => c.name).join(', ');
---

<BaseLayout title={`${title} — idenfit Blog`} description={excerpt}>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="flex flex-col gap-12 lg:flex-row lg:items-start">
      <article class="min-w-0 max-w-3xl flex-1">
        <a href="/blog/" class="text-sm font-semibold text-brand hover:underline">← Blog</a>

        <header class="mt-6">
          {categoryLabel && <span class="text-xs font-bold uppercase tracking-wide text-brand">{categoryLabel}</span>}
          <h1 class="mt-2 text-3xl font-bold leading-tight tracking-tight text-heading sm:text-4xl">{title}</h1>
          <div class="mt-3 flex items-center gap-2 text-sm text-muted">
            <time datetime={date.toISOString()}>{formatBlogDate(date)}</time>
            <span aria-hidden="true">·</span>
            <span>{estimateReadingMinutes(content)} dakikalık okuma</span>
            {formatBlogDate(modifiedDate) !== formatBlogDate(date) && (
              <>
                <span aria-hidden="true">·</span>
                <span>Güncellendi: {formatBlogDate(modifiedDate)}</span>
              </>
            )}
          </div>
        </header>

        {
          featuredImage && (
            <img
              src={featuredImage.url}
              alt={featuredImage.alt}
              width={featuredImage.width}
              height={featuredImage.height}
              class="mt-8 w-full rounded-2xl object-cover"
            />
          )
        }

        <div
          class="mt-8 max-w-none text-body [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-heading [&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:text-lg [&_h3]:font-bold [&_h3]:text-heading [&_p]:mt-4 [&_p]:leading-relaxed [&_a]:text-brand [&_a]:underline [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mt-1 [&_img]:my-6 [&_img]:rounded-2xl [&_img]:object-cover"
          set:html={content}
        />
      </article>

      <BlogSidebar allPosts={allPosts} />
    </div>

    {
      relatedPosts.length > 0 && (
        <section class="mt-16 border-t border-gray-100 pt-12">
          <h2 class="text-xl font-bold text-heading">Benzer Yazılar</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {relatedPosts.map((related, i) => (
              <a
                href={`/blog/${related.data.slug}/`}
                class="reveal group"
                style={`transition-delay: ${Math.min(i, 6) * 60}ms`}
              >
                {related.data.featuredImage && (
                  <span class="block aspect-[4/3] w-full overflow-hidden rounded-md">
                    <img
                      src={related.data.featuredImage.url}
                      alt={related.data.featuredImage.alt}
                      width={related.data.featuredImage.width}
                      height={related.data.featuredImage.height}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                    />
                  </span>
                )}
                {related.data.categories[0] && (
                  <span class="mt-2 block text-xs font-bold uppercase tracking-wide text-brand">
                    {related.data.categories[0].name}
                  </span>
                )}
                <h3 class="mt-1 text-sm font-semibold leading-snug text-heading transition-colors group-hover:text-brand">
                  {related.data.title}
                </h3>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>

  <script src="../../scripts/scroll-reveal.js"></script>
</BaseLayout>
