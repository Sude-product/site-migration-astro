---
export const prerender = true;
import SecurityPage from '../components/SecurityPage.astro';
import { getSecurityItems, getSecurityLocaleUrls, getSecurityMeta } from '../data/miscPagesContent';
import { getTranslations } from '../i18n';

const t = getTranslations('tr');
const items = getSecurityItems('tr');
const localeUrls = getSecurityLocaleUrls();
const meta = getSecurityMeta('tr');
---

<SecurityPage
  title={t.footer.links.about.security}
  pageTitle={meta.pageTitle}
  description={meta.description}
  items={items}
  localeUrls={localeUrls}
/>
