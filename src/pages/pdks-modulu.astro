---
// PİLOT — yalnızca PDKS modülü (Aşama 1). Diğer 88 ürün/modül sayfası
// henüz route'lanmadı, onay bekliyor (bkz. CLAUDE.md).
import ProductPage from '../components/ProductPage.astro';
import { getProductContent, getProductLocaleUrls, getProductPageTitle } from '../data/productContent';

const trSlug = 'pdks-modulu';
const content = getProductContent(trSlug, 'tr')!;
const pageTitle = getProductPageTitle(trSlug, 'tr');
const localeUrls = getProductLocaleUrls(trSlug);
---

<ProductPage content={content} pageTitle={pageTitle} localeUrls={localeUrls} />
