---
import ProductPage from '../components/ProductPage.astro';
import { getWhyIdenfitContent, getWhyIdenfitLocaleUrls, getWhyIdenfitTitle } from '../data/miscPagesContent';

const content = { ...getWhyIdenfitContent('tr')!, faq: [] };
const pageTitle = getWhyIdenfitTitle('tr');
const localeUrls = getWhyIdenfitLocaleUrls();
---

<ProductPage content={content} pageTitle={pageTitle} localeUrls={localeUrls} />
