---
import ProductPage from '../../components/ProductPage.astro';
import { getHardwareContent, getHardwareLocaleUrls, getHardwarePageTitle } from '../../data/hardwareContent';
import { buildIdenfitTitle } from '../../data/pageTitle';

const content = { ...getHardwareContent('it')!, faq: [] };
// `pageTitle` (H1 için hâlâ kullanılıyor) kaynağın hero cümlesi — `<title>`
// etiketinde 79 karaktere çıkıp 60 sınırını aşıyordu (2026-08-10 title
// uzunluk denetimi). `<title>` için kısa, gerçek bir başlık kullanıldı.
const pageTitle = getHardwarePageTitle('it');
const title = buildIdenfitTitle('Integrazioni Hardware', 'it');
const localeUrls = getHardwareLocaleUrls();
---

<ProductPage content={content} pageTitle={pageTitle} title={title} localeUrls={localeUrls} />
