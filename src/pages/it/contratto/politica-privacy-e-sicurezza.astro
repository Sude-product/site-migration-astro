---
import LegalPage from '../../../components/LegalPage.astro';
import { getPrivacySecurityContent, getPrivacySecurityLocaleUrls } from '../../../data/miscPagesContent';

const content = getPrivacySecurityContent('it')!;
const localeUrls = getPrivacySecurityLocaleUrls();
const description =
  'Consulta la politica sulla privacy e sicurezza di idenfit: come proteggiamo i tuoi dati e quali misure di sicurezza applichiamo.';
---

<LegalPage content={content} localeUrls={localeUrls} description={description} hreflangLocales={['tr', 'en', 'it']} />
