---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import CustomerStoryCarouselSection from '../../components/CustomerStoryCarouselSection.astro';
import LogoStrip from '../../components/LogoStrip.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import VideoSection from '../../components/VideoSection.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import EfficiencySection from '../../components/EfficiencySection.astro';
import PanelFeatureSection from '../../components/PanelFeatureSection.astro';
import SupremaSection from '../../components/SupremaSection.astro';
import CertificationBadges from '../../components/CertificationBadges.astro';
import TestimonialSection from '../../components/TestimonialSection.astro';
import HomeFaqSection from '../../components/HomeFaqSection.astro';
import { getTranslations } from '../../i18n';
import { truncateAtWord } from '../../data/metaDescription';

const t = getTranslations(Astro.currentLocale ?? 'it');
// `t.hero.title` görünür hero başlığıyla PAYLAŞILAN gerçek metin —
// `<title>` etiketi 63 karakterle 60 sınırını aşıyordu (2026-08-10 title
// uzunluk denetimi). `truncateAtWord()` yalnızca `<title>` için kırpıyor
// (kelime ortasından kesmiyor), görünür H1 (`HeroSection.astro`) DEĞİŞMİYOR.
const title = `idenfit — ${truncateAtWord(t.hero.title.replace('\n', ' '), 50)}`;
// `t.hero.description` görünür hero alt başlığıyla PAYLAŞILAN, canlı
// siteyle doğrulanmış gerçek metin — meta description denetimi (2026-08-10)
// bu dilde 185 karakter çıkardı, 160 sınırı için yalnızca META ETİKETİNDE
// kırpılıyor (`truncateAtWord()`, kelime ortasından kesmiyor) — hero'nun
// GÖRÜNÜR metni (`HeroSection.astro`) DEĞİŞMEDEN kalıyor.
const metaDescription = truncateAtWord(t.hero.description);
---

<BaseLayout title={title} description={metaDescription}>
	<HeroSection />
	<CustomerStoryCarouselSection />
	<LogoStrip />
	<SectionDivider text={t.home.dividers.afterLogos} />
	<VideoSection />
	<FeatureGrid />
	<SectionDivider text={t.home.dividers.afterFeatures} />
	<EfficiencySection />
	<PanelFeatureSection />
	<SupremaSection />
	<CertificationBadges />
	<TestimonialSection />
	<HomeFaqSection />
	<script src="../../scripts/scroll-reveal.js"></script>
</BaseLayout>
