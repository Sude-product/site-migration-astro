---
export const prerender = true;
// Aşama 2 — onaylı 5 modülden biri (İşe Alım/ATS). Bkz. CLAUDE.md.
// 2026-09-02 — canlı site tamamen Hiringoz'a yeniden markalandı (bkz.
// `productTranslationOverrides.ts`'teki yorum), gerçek İngilizce çeviri
// artık kaynakta VAR. Hero uzun bir pazarlama cümlesi olduğu için
// `<title>`/CTA anahtar kelimesi kısa, gerçek bir isimle override edildi
// (`en/hardware.astro`'nun AYNI deseni).
import ProductPage from '../../components/ProductPage.astro';
import { getProductContent, getProductLocaleUrls, getProductPageTitle, getProductModifiedDate } from '../../data/productContent';
import { buildIdenfitTitle } from '../../data/pageTitle';
import { HIRINGOZ_PARTNER_LOGO } from '../../data/productTranslationOverrides';

const trSlug = 'ise-alim-modulu';
const content = getProductContent(trSlug, 'en')!;
const pageTitle = getProductPageTitle(trSlug, 'en');
const title = buildIdenfitTitle('Hiring Module', 'en');
const ctaKeyword = 'Hiring Module';
const localeUrls = getProductLocaleUrls(trSlug);
const modified = getProductModifiedDate(trSlug, 'en');
---

<ProductPage
  content={content}
  pageTitle={pageTitle}
  title={title}
  ctaKeyword={ctaKeyword}
  localeUrls={localeUrls}
  modified={modified}
  heroLayout="stacked"
  heroPartnerLogo={HIRINGOZ_PARTNER_LOGO}
/>
