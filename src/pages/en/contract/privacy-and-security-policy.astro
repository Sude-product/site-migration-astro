---
import LegalPage from '../../../components/LegalPage.astro';
import { getPrivacySecurityContent, getPrivacySecurityLocaleUrls, getPrivacySecurityModifiedDate } from '../../../data/miscPagesContent';

const content = getPrivacySecurityContent('en')!;
const localeUrls = getPrivacySecurityLocaleUrls();
const modified = getPrivacySecurityModifiedDate('en');
const description =
  "Review idenfit's privacy and security policy — how we protect user data, the security measures we apply, and our privacy principles.";
---

<LegalPage content={content} localeUrls={localeUrls} description={description} hreflangLocales={['tr', 'en', 'it']} modified={modified} />
