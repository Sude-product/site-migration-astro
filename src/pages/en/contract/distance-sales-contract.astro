---
import LegalPage from '../../../components/LegalPage.astro';
import { getLegalContent, getLegalLocaleUrls, DISTANCE_SALES_TR_SLUG } from '../../../data/miscPagesContent';

const content = getLegalContent(DISTANCE_SALES_TR_SLUG, 'en')!;
const localeUrls = getLegalLocaleUrls(DISTANCE_SALES_TR_SLUG);
const description =
  "Learn the terms of idenfit's Distance Sales Contract, including your right of withdrawal and payment conditions for online purchases.";
---

<LegalPage content={content} localeUrls={localeUrls} description={description} />
