---
import ProductPage from '../../components/ProductPage.astro';
import { getHardwareContent, getHardwareLocaleUrls, getHardwarePageTitle } from '../../data/hardwareContent';
import { buildIdenfitTitle } from '../../data/pageTitle';

const content = { ...getHardwareContent('en')!, faq: [] };
// `pageTitle` (H1 için hâlâ kullanılıyor) kaynağın hero cümlesi — `<title>`
// etiketinde 85 karaktere çıkıp 60 sınırını aşıyordu (2026-08-10 title
// uzunluk denetimi). `<title>` için kısa, gerçek bir başlık kullanıldı.
const pageTitle = getHardwarePageTitle('en');
const title = buildIdenfitTitle('Hardware & Device Integrations', 'en');
const localeUrls = getHardwareLocaleUrls();
// `ctaKeyword` (2026-08-12, CTA/anchor text optimizasyonu) — `title`
// override'ıyla AYNI kısa/gerçek isim, CTA anchor text'i için de kullanılıyor.
const ctaKeyword = 'Hardware & Device Integrations';
---

<ProductPage content={content} pageTitle={pageTitle} title={title} ctaKeyword={ctaKeyword} localeUrls={localeUrls} />
