---
export const prerender = true;
// Mesafeli Satış Sözleşmesi — KOBİ paket (TR). Eski WP id 20212. Mikro
// varyantından farkı: 11 madde (fazladan "Madde 5 — Lisans ve Hizmet
// Bedelleri ve Ödeme Koşulları"), 50 kullanıcı, aylık otomatik yenileme ve
// implementasyon hizmetleri. Bu yüzden iki sayfa birbirinin yerine
// GEÇEMEZ — bkz. `distanceSalesPackagesContent.ts`.
import LegalPage from '../../components/LegalPage.astro';
import {
  getDistanceSalesPackageContent,
  getDistanceSalesPackageLocaleUrls,
  getDistanceSalesPackageModifiedDate,
  getDistanceSalesPackageMetaDescription,
  DISTANCE_SALES_SME_TR_SLUG,
  DISTANCE_SALES_PACKAGE_HREFLANG_LOCALES,
} from '../../data/distanceSalesPackagesContent';

const content = getDistanceSalesPackageContent(DISTANCE_SALES_SME_TR_SLUG, 'tr')!;
const localeUrls = getDistanceSalesPackageLocaleUrls(DISTANCE_SALES_SME_TR_SLUG);
const modified = getDistanceSalesPackageModifiedDate(DISTANCE_SALES_SME_TR_SLUG, 'tr');
const description = getDistanceSalesPackageMetaDescription(DISTANCE_SALES_SME_TR_SLUG, 'tr');
---

<LegalPage
  content={content}
  localeUrls={localeUrls}
  description={description}
  hreflangLocales={DISTANCE_SALES_PACKAGE_HREFLANG_LOCALES}
  modified={modified}
/>
