---
export const prerender = true;
import ProductPage from '../../components/ProductPage.astro';
import { getHardwareContent, getHardwareLocaleUrls, getHardwarePageTitle, getHardwareModifiedDate } from '../../data/hardwareContent';
import { buildIdenfitTitle } from '../../data/pageTitle';

const content = { ...getHardwareContent('nl')!, faq: [] };
const modified = getHardwareModifiedDate('nl');
// `pageTitle` (H1 için hâlâ kullanılıyor) kaynağın hero cümlesi — `<title>`
// etiketinde 88 karaktere çıkıp 60 sınırını aşıyordu (2026-08-10 title
// uzunluk denetimi). `<title>` için kısa, gerçek bir başlık kullanıldı.
const pageTitle = getHardwarePageTitle('nl');
const title = buildIdenfitTitle('Hardware-integraties', 'nl');
const localeUrls = getHardwareLocaleUrls();
// `ctaKeyword` (2026-08-12, CTA/anchor text optimizasyonu) — `title`
// override'ıyla AYNI kısa/gerçek isim, CTA anchor text'i için de kullanılıyor.
const ctaKeyword = 'Hardware-integraties';
---

<ProductPage content={content} pageTitle={pageTitle} title={title} ctaKeyword={ctaKeyword} localeUrls={localeUrls} modified={modified} />
