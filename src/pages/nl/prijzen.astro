---
export const prerender = true;
import PricingPage from '../../components/PricingPage.astro';
import { getPricingContent, getPricingLocaleUrls, getPricingModifiedDate } from '../../data/pricingContent';

const content = getPricingContent('nl')!;
const localeUrls = getPricingLocaleUrls();
const modified = getPricingModifiedDate('nl');
---

<PricingPage content={content} localeUrls={localeUrls} modified={modified} />
