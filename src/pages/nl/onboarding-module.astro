---
// Aşama 2 — onaylı 5 modülden biri (Onboarding). Bkz. CLAUDE.md.
import ProductPage from '../../components/ProductPage.astro';
import { getProductContent, getProductLocaleUrls, getProductPageTitle, getProductModifiedDate } from '../../data/productContent';

const trSlug = 'onboarding-modulu';
const content = getProductContent(trSlug, 'nl')!;
const pageTitle = getProductPageTitle(trSlug, 'nl');
const localeUrls = getProductLocaleUrls(trSlug);
const modified = getProductModifiedDate(trSlug, 'nl');
// hero.text 59 karakter (meta description denetimi, 2026-08-10) — sayfanın
// kendi gövde metnindeki gerçek temalardan (e-handtekeningen, welkomst-
// e-mails, dag-1 betrokkenheid) türetildi.
const description =
  "idenfit's inwerkmodule automatiseert papierwerk, handtekeningen en welkomst-e-mails, zodat nieuwe medewerkers zich vanaf dag 1 betrokken voelen.";
---

<ProductPage content={content} pageTitle={pageTitle} localeUrls={localeUrls} description={description} modified={modified} />
