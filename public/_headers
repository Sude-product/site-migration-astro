# ⚠️ BU DOSYA ÜRETİLİYOR — ELLE DÜZENLEMEYİN.
# Kaynak: src/data/csp.ts  ·  Yeniden üret: node scripts/check-csp-sync.mjs --fix
# Doğrula:  node scripts/check-csp-sync.mjs   (sapma varsa exit 1)
#
# Cloudflare Workers+Assets `_headers` formatı. Bu dosya YALNIZCA statik
# varlık katmanından servis edilen (prerender=true) sayfalara uygulanır;
# dinamik/SSR rotaların (`/keystatic/*`, `/api/*`) aynı başlıkları
# `src/middleware.ts` üzerinden alır.
#
# Politikanın gerekçeleri (hangi izin neden var, neyin bilerek DIŞARIDA
# bırakıldığı, style-src 'unsafe-inline'ın neden kaldırılamadığı) tek tek
# src/data/csp.ts'te yorum olarak yazılı — burada TEKRARLANMIYOR.
#
# script-src'teki 'unsafe-inline' bir FAIL-SAFE varsayılan:
# `scripts/generate-csp-headers.mjs` build sonrası bunu dist/client/_headers'ta
# gerçek SHA256 hash listesiyle değiştiriyor. Generator çalışmazsa site
# bugünkü çalışan politikayla yayına gider, bozuk bir direktifle değil.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Reporting-Endpoints: csp-endpoint="/api/csp-report"
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.youtube.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://*.cookie-script.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://img.youtube.com https://lh3.googleusercontent.com https://*.google-analytics.com https://*.googletagmanager.com; frame-src https://www.youtube.com https://www.google.com/recaptcha/ https://docs.google.com https://www.googletagmanager.com; frame-ancestors 'self'; connect-src 'self' https://www.google.com/recaptcha/ https://*.cookie-script.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; report-to csp-endpoint; report-uri /api/csp-report

/keystatic/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Reporting-Endpoints: csp-endpoint="/api/csp-report"
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://keystatic.cloud https://api.keystatic.cloud; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://keystatic.cloud https://api.keystatic.cloud wss://live.keystatic.cloud https://api.github.com https://github.com https://raw.githubusercontent.com; frame-src https://github.com https://keystatic.cloud; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://github.com; report-to csp-endpoint; report-uri /api/csp-report
