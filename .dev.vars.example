# Form backend (Açık nokta #2/#28) yerel geliştirme secret'ları — bu dosyayı
# `.dev.vars` adıyla kopyalayıp gerçek değerleri doldurun (`.dev.vars`
# .gitignore'da, asla commit edilmez). Wrangler bunu `astro dev`/`astro
# preview` sırasında otomatik okuyup `Astro.locals.runtime.env`'e enjekte
# eder — bkz. `src/env.d.ts`. Canlıda (Cloudflare Pages) aynı adlar
# `wrangler secret put <ad>` veya Pages panelinden ayarlanır.

# SendGrid Mail Send API anahtarı — HENÜZ YOK, kullanıcı bekleniyor.
SENDGRID_API_KEY=

# SendGrid'de doğrulanmış (Sender Authentication) gönderen e-postası.
SENDGRID_FROM_EMAIL=

# Form bildirimlerinin gideceği GENEL kutu. Aşağıdaki forma özel
# değişkenlerden biri tanımlı DEĞİLSE o form bu adrese düşer (fallback).
LEAD_NOTIFICATION_EMAIL=

# Form başına bildirim adresi (2026-09-04) — her formun lead'i farklı ekibe
# gidebilsin diye. Boş bırakılan HER form yukarıdaki genel adrese düşer,
# yani yalnızca ayrıştırmak istediklerinizi doldurmanız yeterli.
# Her biri VİRGÜLLE birden fazla adres alabilir: satis@idenfit.com,mudur@idenfit.com
LEAD_EMAIL_HERO=
LEAD_EMAIL_CONTACT=
LEAD_EMAIL_LANDING=
LEAD_EMAIL_SUPPORT=
LEAD_EMAIL_PRESENTATION=
LEAD_EMAIL_HR_MATURITY=

# reCAPTCHA v3 sunucu-taraflı secret (skeleton — bkz. lead.ts). Boşken
# doğrulama adımı atlanır, form akışı BOZULMAZ.
RECAPTCHA_SECRET_KEY=

# GÜVENLİK (2026-09-04) — /api/maturity-pdf'in paylaşılan pilot secret'ı.
# Bu endpoint yalnızca deploy-sonrası MANUEL pilot/kabul testi içindir —
# boşken (varsayılan) endpoint TAMAMEN 404 döner. Pilot testi tekrar
# yapmak isterseniz güçlü/rastgele bir değer üretip buraya yazın, aynı
# değeri isteğin `X-Pilot-Secret` header'ında gönderin.
MATURITY_PDF_PILOT_SECRET=

# Satış CRM aktarımı (2026-10-09, src/data/crmLeadSync.ts). idenfit-api'deki
# OAuth2 client_credentials istemcisi: kapsam crm.leads.write, globme
# organizasyonuna bağlı. Canlıda SECRET olarak girilir:
#   npx wrangler secret put IDENFIT_CRM_CLIENT_ID
#   npx wrangler secret put IDENFIT_CRM_CLIENT_SECRET
# Boşken aktarım hiç denenmez, form akışı etkilenmez. Yerelde test için
# IDENFIT_CRM_API_URL'i dev API'ye (https://dev-api.testing.idenfit.com)
# çevirmeyi unutmayın — wrangler.json'daki varsayılan CANLI API.
IDENFIT_CRM_API_URL=
IDENFIT_CRM_CLIENT_ID=
IDENFIT_CRM_CLIENT_SECRET=
